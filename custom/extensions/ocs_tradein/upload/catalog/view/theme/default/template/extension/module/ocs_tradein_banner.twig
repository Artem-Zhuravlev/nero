{# Extension: ocs_tradein. Banner with the request button (SPEC-036 REQ-CRD-010); the button is handled by OCS.req. #}
<div class="ocs-tradein">
  <div><strong>{{ title }}</strong><p>{{ text }}</p></div>
  <button type="button" class="btn btn-primary ocs-req-btn ocs-tradein-btn" data-form="{{ form }}" data-product-id="{{ product_id }}">{{ button }}</button>
</div>
