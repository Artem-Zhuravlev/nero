{# Extension: ocs_mega_menu. Mega menu markup (SPEC-027). Keeps core hooks: #menu, #category, .navbar-toggle with data-toggle="collapse". #}
<nav id="menu" class="navbar ocs-mega" data-behaviour="{{ behaviour }}" aria-label="{{ text_catalog }}">
  <div class="container">
    <div class="navbar-header"><span id="category" class="visible-xs">{{ text_catalog }}</span>
      <button type="button" class="btn btn-navbar navbar-toggle" data-toggle="collapse" data-target=".navbar-ex1-collapse" aria-label="{{ text_catalog }}"><i class="fa fa-bars"></i></button>
    </div>
    <div class="collapse navbar-collapse navbar-ex1-collapse">
      <button type="button" class="ocs-mega-open hidden-xs" aria-expanded="false" aria-controls="ocs-mega-panel"><i class="fa fa-bars"></i> {{ text_catalog }}</button>
      <ul class="ocs-mega-l1 list-unstyled" id="ocs-mega-panel">
        {% for c in categories %}
        <li class="ocs-mega-item{% if c.popular %} ocs-popular{% endif %}{% if c.active %} active{% endif %}{% if c.children %} ocs-has-children{% endif %}">
          <a href="{{ c.href }}" class="ocs-mega-link">{% if c.icon.type == 'fa' %}<i class="fa {{ c.icon.value }}"></i>{% elseif c.icon.type == 'image' %}<img src="{{ c.icon.src }}" alt="" width="24" height="24" loading="lazy" />{% endif %}<span>{{ c.name }}</span></a>
          {% if c.children %}
          <button type="button" class="ocs-mega-expand" aria-expanded="false" aria-label="{{ c.name }}"><i class="fa fa-angle-right"></i></button>
          <div class="ocs-mega-fly" style="--ocs-cols: {{ columns }}">
            <div class="ocs-mega-cols">
              {% for g in c.children %}
              <div class="ocs-mega-group">
                <a class="ocs-mega-gtitle" href="{{ g.href }}">{{ g.name }}</a>
                {% if g.children %}
                <ul class="list-unstyled">
                  {% for l in g.children %}
                  <li><a href="{{ l.href }}">{{ l.name }}</a></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            {% if c.banner %}<a class="ocs-mega-promo" href="{{ c.banner.url }}"><img src="{{ c.banner.src }}" alt="" loading="lazy" /></a>{% endif %}
            <a href="{{ c.href }}" class="see-all">{{ text_all }} {{ c.name }}</a>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</nav>
