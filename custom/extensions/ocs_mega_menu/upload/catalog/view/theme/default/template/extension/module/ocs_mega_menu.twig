{# Extension: ocs_mega_menu. Mega menu markup (SPEC-027). Keeps core hooks: #menu, #category, .navbar-toggle ; the mobile panel is opened by theme.js (data-ocs-menu), not by Bootstrap collapse (SPEC-090). #}
<nav id="menu" class="navbar ocs-mega" data-behaviour="{{ behaviour }}" aria-label="{{ text_catalog }}">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="btn btn-navbar navbar-toggle" data-ocs-menu="toggle" aria-controls="ocs-mega-drawer" aria-expanded="false"><span id="category">{{ text_catalog }}</span><svg class="ocs-i" aria-hidden="true"><use href="#i-menu"/></svg></button>
    </div>
    <div class="collapse navbar-collapse navbar-ex1-collapse" id="ocs-mega-drawer">
      <button type="button" class="ocs-mega-close visible-xs" data-ocs-menu="close" aria-label="{{ text_catalog }}">&times;</button>
      <button type="button" class="ocs-mega-open hidden-xs" aria-expanded="false" aria-controls="ocs-mega-panel"><svg class="ocs-i" aria-hidden="true"><use href="#i-menu"/></svg> {{ text_catalog }}</button>
      <ul class="ocs-mega-l1 list-unstyled" id="ocs-mega-panel">
        {% for c in categories %}
        <li class="ocs-mega-item{% if c.popular %} ocs-popular{% endif %}{% if c.active %} active{% endif %}{% if c.children %} ocs-has-children{% endif %}">
          <a href="{{ c.href }}" class="ocs-mega-link">{% if c.icon.type == 'svg' %}<svg class="ocs-i" aria-hidden="true"><use href="#{{ c.icon.value }}"/></svg>{% elseif c.icon.type == 'image' %}<img src="{{ c.icon.src }}" alt="" width="24" height="24" loading="lazy" />{% else %}<i class="ocs-icon-gap" aria-hidden="true"></i>{% endif %}<span>{{ c.name }}</span></a>
          {% if c.children %}
          <button type="button" class="ocs-mega-expand" aria-expanded="false" aria-label="{{ c.name }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
          <div class="ocs-mega-fly" style="--ocs-cols: {{ columns }}">
            <div class="ocs-mega-fly-in">
            <div class="ocs-mega-body">
            <div class="ocs-mega-cols">
              {% for g in c.children %}
              <div class="ocs-mega-group">
                <a class="ocs-mega-gtitle" href="{{ g.href }}">{{ g.name }}</a>
                {% if g.children %}
                <ul class="list-unstyled">
                  {% for l in g.children %}
                  <li><a href="{{ l.href }}">{{ l.name }}</a></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            </div>
            {% if c.banner %}<a class="ocs-mega-promo" href="{{ c.banner.url }}"><img src="{{ c.banner.src }}" alt="" width="240" height="360" loading="lazy" /></a>{% endif %}
            </div>
          </div>
          {% endif %}
        </li>
        {% endfor %}
        {% if brands %}
        <li class="ocs-mega-item ocs-mega-branditem ocs-has-children">
          <a href="{{ href_brands }}" class="ocs-mega-link"><svg class="ocs-i" aria-hidden="true"><use href="#i-tag"/></svg><span>{{ text_brands }}</span></a>
          <button type="button" class="ocs-mega-expand" aria-expanded="false" aria-label="{{ text_brands }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
          <div class="ocs-mega-fly">
            <div class="ocs-mega-fly-in">
            <div class="ocs-mega-body">
              <ul class="ocs-mega-brandlist list-unstyled">
                {% for b in brands %}<li><a href="{{ b.href }}">{{ b.name }}</a></li>{% endfor %}
              </ul>
            </div>
            </div>
          </div>
        </li>
        {% endif %}
      </ul>
    </div>
  </div>
</nav>
