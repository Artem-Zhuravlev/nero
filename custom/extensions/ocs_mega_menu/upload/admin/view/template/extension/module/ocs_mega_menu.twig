{# Extension: ocs_mega_menu. Admin settings form. Owner: SPEC-027. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-menu" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-menu" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="module_ocs_mega_menu_status" id="input-status" class="form-control">
                  <option value="1"{% if module_ocs_mega_menu_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_ocs_mega_menu_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-levels">{{ entry_levels }}</label>
              <div class="col-sm-10">
                <select name="module_ocs_mega_menu_levels" id="input-levels" class="form-control">
                  {% for n in 1..3 %}<option value="{{ n }}"{% if module_ocs_mega_menu_levels == n %} selected="selected"{% endif %}>{{ n }}</option>{% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-columns">{{ entry_columns }}</label>
              <div class="col-sm-10">
                <select name="module_ocs_mega_menu_columns" id="input-columns" class="form-control">
                  {% for n in 1..5 %}<option value="{{ n }}"{% if module_ocs_mega_menu_columns == n %} selected="selected"{% endif %}>{{ n }}</option>{% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-behaviour">{{ entry_behaviour }}</label>
              <div class="col-sm-10">
                <select name="module_ocs_mega_menu_behaviour" id="input-behaviour" class="form-control">
                  <option value="hover"{% if module_ocs_mega_menu_behaviour == 'hover' %} selected="selected"{% endif %}>{{ text_hover }}</option>
                  <option value="click"{% if module_ocs_mega_menu_behaviour == 'click' %} selected="selected"{% endif %}>{{ text_click }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-brands">{{ entry_brands }}</label>
              <div class="col-sm-10">
                <select name="module_ocs_mega_menu_brands" id="input-brands" class="form-control">
                  <option value="1"{% if module_ocs_mega_menu_brands %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_ocs_mega_menu_brands %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_extras }}</legend>
            <p class="text-muted">{{ help_extras }}</p>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td>{{ column_category }}</td>
                    <td>{{ column_icon }}</td>
                    <td class="text-center">{{ column_popular }}</td>
                    <td>{{ column_banner_image }}</td>
                    <td>{{ column_banner_url }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% for category in categories %}
                  <tr>
                    <td>{{ category.name }}</td>
                    <td><input type="text" name="ocs_extras[{{ category.category_id }}][icon]" value="{{ category.icon }}" class="form-control" /></td>
                    <td class="text-center"><input type="checkbox" name="ocs_extras[{{ category.category_id }}][popular]" value="1"{% if category.popular %} checked="checked"{% endif %} /></td>
                    <td><input type="text" name="ocs_extras[{{ category.category_id }}][banner_image]" value="{{ category.banner_image }}" class="form-control" /></td>
                    <td><input type="text" name="ocs_extras[{{ category.category_id }}][banner_url]" value="{{ category.banner_url }}" class="form-control" /></td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </fieldset>
        </form>
        <p class="text-muted">ocs_mega_menu v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
