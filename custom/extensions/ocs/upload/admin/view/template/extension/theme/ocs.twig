{# Extension: ocs (theme). Admin settings form. Owner: SPEC-006. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-theme" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-theme" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-directory"><span data-toggle="tooltip" title="{{ help_directory }}">{{ entry_directory }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_ocs_directory" value="{{ theme_ocs_directory }}" id="input-directory" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="theme_ocs_status" id="input-status" class="form-control">
                  <option value="1"{% if theme_ocs_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not theme_ocs_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_product }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-catalog-limit"><span data-toggle="tooltip" title="{{ help_product_limit }}">{{ entry_product_limit }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_ocs_product_limit" value="{{ theme_ocs_product_limit }}" id="input-catalog-limit" class="form-control" />
                {% if error_product_limit %}<div class="text-danger">{{ error_product_limit }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-description-limit"><span data-toggle="tooltip" title="{{ help_product_description_length }}">{{ entry_product_description_length }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_ocs_product_description_length" value="{{ theme_ocs_product_description_length }}" id="input-description-limit" class="form-control" />
                {% if error_product_description_length %}<div class="text-danger">{{ error_product_description_length }}</div>{% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_image }}</legend>
            {% for role in roles %}
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-{{ role }}-width">{{ attribute(_context, 'entry_image_' ~ role) }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-3"><input type="text" name="theme_ocs_image_{{ role }}_width" value="{{ attribute(_context, 'theme_ocs_image_' ~ role ~ '_width') }}" placeholder="{{ entry_width }}" id="input-image-{{ role }}-width" class="form-control" /></div>
                  <div class="col-sm-3"><input type="text" name="theme_ocs_image_{{ role }}_height" value="{{ attribute(_context, 'theme_ocs_image_' ~ role ~ '_height') }}" placeholder="{{ entry_height }}" class="form-control" /></div>
                </div>
                {% if attribute(_context, 'error_image_' ~ role) %}<div class="text-danger">{{ attribute(_context, 'error_image_' ~ role) }}</div>{% endif %}
              </div>
            </div>
            {% endfor %}
          </fieldset>
        </form>
        <p class="text-muted">OCS theme v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
