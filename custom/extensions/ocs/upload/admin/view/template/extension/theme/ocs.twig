{# Extension: ocs (theme). Admin settings form. Owner: SPEC-006. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-theme" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        {% if setup %}<a href="{{ setup }}" data-toggle="tooltip" title="Setup" class="btn btn-warning"><i class="fa fa-magic"></i></a>
        {% endif %}<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if setup_pending %}
    <div class="alert alert-warning"><i class="fa fa-magic"></i> <a href="{{ setup }}">Setup</a>: the OCS tables, settings and modules are not installed yet.</div>
    {% endif %}
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-theme" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-directory"><span data-toggle="tooltip" title="{{ help_directory }}">{{ entry_directory }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_ocs_directory" value="{{ theme_ocs_directory }}" id="input-directory" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="theme_ocs_status" id="input-status" class="form-control">
                  <option value="1"{% if theme_ocs_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not theme_ocs_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_product }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-catalog-limit"><span data-toggle="tooltip" title="{{ help_product_limit }}">{{ entry_product_limit }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_ocs_product_limit" value="{{ theme_ocs_product_limit }}" id="input-catalog-limit" class="form-control" />
                {% if error_product_limit %}<div class="text-danger">{{ error_product_limit }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-description-limit"><span data-toggle="tooltip" title="{{ help_product_description_length }}">{{ entry_product_description_length }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="theme_ocs_product_description_length" value="{{ theme_ocs_product_description_length }}" id="input-description-limit" class="form-control" />
                {% if error_product_description_length %}<div class="text-danger">{{ error_product_description_length }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-show-stock"><span data-toggle="tooltip" title="{{ help_show_stock }}">{{ entry_show_stock }}</span></label>
              <div class="col-sm-10">
                <select name="theme_ocs_show_stock" id="input-show-stock" class="form-control">
                  <option value="1"{% if theme_ocs_show_stock %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not theme_ocs_show_stock %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-show-sku"><span data-toggle="tooltip" title="{{ help_show_sku }}">{{ entry_show_sku }}</span></label>
              <div class="col-sm-10">
                <select name="theme_ocs_show_sku" id="input-show-sku" class="form-control">
                  <option value="1"{% if theme_ocs_show_sku %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not theme_ocs_show_sku %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_contacts }}</legend>
            <ul class="nav nav-tabs" id="contact-lang">
              {% for language in languages %}
              <li{% if loop.first %} class="active"{% endif %}><a href="#contact-l{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
              {% endfor %}
            </ul>
            <div class="tab-content">
              {% for language in languages %}
              <div class="tab-pane{% if loop.first %} active{% endif %}" id="contact-l{{ language.language_id }}">
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-address-{{ language.code }}">{{ entry_address }}</label>
                  <div class="col-sm-10"><input type="text" name="theme_ocs_contact[{{ language.code }}][address]" value="{{ contact[language.code].address }}" maxlength="255" id="input-address-{{ language.code }}" class="form-control" /></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-hours-{{ language.code }}">{{ entry_hours }}</label>
                  <div class="col-sm-10"><textarea name="theme_ocs_contact[{{ language.code }}][hours]" rows="3" maxlength="500" id="input-hours-{{ language.code }}" class="form-control">{{ contact[language.code].hours }}</textarea></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-phones-{{ language.code }}"><span data-toggle="tooltip" title="{{ help_phones }}">{{ entry_phones }}</span></label>
                  <div class="col-sm-10"><textarea name="theme_ocs_contact[{{ language.code }}][phones]" rows="3" maxlength="500" id="input-phones-{{ language.code }}" class="form-control">{{ contact[language.code].phones }}</textarea></div>
                </div>
              </div>
              {% endfor %}
            </div>
            <legend>{{ text_contact_links }}</legend>
            <p class="help-block">{{ help_contact_links }}</p>
            <div class="table-responsive">
              <table class="table table-bordered" id="contact-links">
                <thead><tr><td>{{ column_icon }}</td><td>{{ column_kind }}</td><td>{{ column_title }}</td><td>{{ column_url }}</td><td>{{ column_sort }}</td><td></td></tr></thead>
                <tbody>
                {% for row in contact_links %}
                <tr>
                  <td><select name="theme_ocs_contact_links[{{ loop.index0 }}][icon]" class="form-control ocs-ic-select" data-ocs-icon>{% for icon in contact_icons %}<option value="{{ icon }}"{% if row.icon == icon %} selected="selected"{% endif %}>{{ icon|capitalize }}</option>{% endfor %}</select> <svg class="ocs-ic-prev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-site"/></svg></td>
                  <td><select name="theme_ocs_contact_links[{{ loop.index0 }}][kind]" class="form-control"><option value="messenger"{% if row.kind == 'messenger' %} selected="selected"{% endif %}>{{ text_kind_messenger }}</option><option value="social"{% if row.kind != 'messenger' %} selected="selected"{% endif %}>{{ text_kind_social }}</option></select></td>
                  <td>{% for language in languages %}<input type="text" name="theme_ocs_contact_links[{{ loop.index0 }}][title][{{ language.code }}]" value="{{ row.title[language.code] }}" maxlength="60" placeholder="{{ language.name }}" class="form-control" />{% endfor %}</td>
                  <td><input type="text" name="theme_ocs_contact_links[{{ loop.index0 }}][url]" value="{{ row.url }}" maxlength="500" placeholder="https://t.me/shop" class="form-control" /></td>
                  <td><input type="text" name="theme_ocs_contact_links[{{ loop.index0 }}][sort]" value="{{ row.sort }}" class="form-control" style="min-width: 70px" /></td>
                  <td class="text-right"><button type="button" class="btn btn-danger" data-ocs-remove title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>
                </tr>
                {% endfor %}
                </tbody>
                <tfoot><tr><td colspan="6" class="text-right"><button type="button" id="contact-link-add" class="btn btn-primary" title="{{ button_add }}"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot>
              </table>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
              <defs>
            <symbol id="i-telegram" viewBox="0 0 24 24"><path d="M21 4 3 11.2l5.6 2.1L10 19l3.2-3.6 4.6 3.4L21 4Z"/><path d="m8.6 13.3 9-6.3"/></symbol>
            <symbol id="i-viber" viewBox="0 0 24 24"><path d="M5 5.5C5 4.7 5.7 4 6.5 4h11c.8 0 1.5.7 1.5 1.5v8c0 .8-.7 1.5-1.5 1.5H13l-3.5 3.5V15H6.5c-.8 0-1.5-.7-1.5-1.5v-8Z"/><path d="M9.8 8c0 2.4 1.8 4.2 4.2 4.2l.8-.9-1.5-1.2-.7.5a2.8 2.8 0 0 1-1.4-1.4l.5-.7L10.7 7 9.8 8Z"/></symbol>
            <symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="m4 20 1.2-4A8 8 0 1 1 8 18.8L4 20Z"/><path d="M9 8.8c0 3 2.2 5.2 5.2 5.2l.9-1.1-1.7-1.2-.8.6a3.4 3.4 0 0 1-1.6-1.6l.6-.8L10.4 7.7 9 8.8Z"/></symbol>
            <symbol id="i-messenger" viewBox="0 0 24 24"><path d="M12 3.5c-4.7 0-8.5 3.4-8.5 7.7 0 2.4 1.2 4.5 3.1 5.9V21l3-1.7c.8.2 1.6.3 2.4.3 4.7 0 8.5-3.4 8.5-7.7S16.7 3.5 12 3.5Z"/><path d="m7.5 13.5 3.2-3.4 2 2 3.8-2.2-3.3 3.6-2-2-3.7 2Z"/></symbol>
            <symbol id="i-instagram" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6"/></symbol>
            <symbol id="i-facebook" viewBox="0 0 24 24"><path d="M14 21v-8h2.6l.5-3H14V8.2c0-.9.4-1.6 1.7-1.6H17V4.1A17 17 0 0 0 14.8 4C12.6 4 11 5.3 11 7.8V10H8.5v3H11v8"/></symbol>
            <symbol id="i-youtube" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="m10 9.5 5 2.5-5 2.5v-5Z"/></symbol>
            <symbol id="i-tiktok" viewBox="0 0 24 24"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.3 2.4 1.8 4 4.5 4.2"/></symbol>
            <symbol id="i-twitter" viewBox="0 0 24 24"><path d="m4 4 16 16M20 4 4 20"/></symbol>
            <symbol id="i-linkedin" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.8v.1M11.5 10.5V16M11.5 13c0-1.3 1-2.5 2.3-2.5S16 11.7 16 13v3"/></symbol>
            <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.4 5.2 3.4 8.5s-1.1 6.1-3.4 8.5C9.7 18.1 8.6 15.3 8.6 12S9.7 5.9 12 3.5Z"/></symbol>
                <symbol id="i-site" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.4 5.2 3.4 8.5s-1.1 6.1-3.4 8.5C9.7 18.1 8.6 15.3 8.6 12S9.7 5.9 12 3.5Z"/></symbol>
                <symbol id="i-email" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></symbol>
                <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></symbol>
                <symbol id="i-map" viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></symbol>
              </defs>
            </svg>
            <script type="text/template" id="contact-link-template">
              <tr>
                  <td><select name="theme_ocs_contact_links[__N__][icon]" class="form-control ocs-ic-select" data-ocs-icon>{% for icon in contact_icons %}<option value="{{ icon }}"{% if x.icon == icon %} selected="selected"{% endif %}>{{ icon|capitalize }}</option>{% endfor %}</select> <svg class="ocs-ic-prev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-site"/></svg></td>
                  <td><select name="theme_ocs_contact_links[__N__][kind]" class="form-control"><option value="messenger"{% if row.kind == 'messenger' %} selected="selected"{% endif %}>{{ text_kind_messenger }}</option><option value="social"{% if row.kind != 'messenger' %} selected="selected"{% endif %}>{{ text_kind_social }}</option></select></td>
                  <td>{% for language in languages %}<input type="text" name="theme_ocs_contact_links[__N__][title][{{ language.code }}]" value="{{ row.title[language.code] }}" maxlength="60" placeholder="{{ language.name }}" class="form-control" />{% endfor %}</td>
                  <td><input type="text" name="theme_ocs_contact_links[__N__][url]" value="{{ row.url }}" maxlength="500" placeholder="https://t.me/shop" class="form-control" /></td>
                  <td><input type="text" name="theme_ocs_contact_links[__N__][sort]" value="{{ row.sort }}" class="form-control" style="min-width: 70px" /></td>
                  <td class="text-right"><button type="button" class="btn btn-danger" data-ocs-remove title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>
                </tr>
            </script>
            <script type="text/javascript"><!--
(function () {
  var body = document.querySelector('#contact-links tbody');
  var tpl = document.getElementById('contact-link-template');
  var next = body.children.length;
  var map = {telegram: 'telegram', viber: 'viber', whatsapp: 'whatsapp', messenger: 'messenger', instagram: 'instagram', facebook: 'facebook', youtube: 'youtube', tiktok: 'tiktok', x: 'twitter', linkedin: 'linkedin', email: 'email', phone: 'phone', map: 'map', site: 'site'};

  function preview(select) {
    var use = select.parentNode.querySelector('use');

    if (use) {
      use.setAttribute('href', '#i-' + (map[select.value] || 'site'));
    }
  }

  function boot(scope) {
    [].forEach.call(scope.querySelectorAll('[data-ocs-icon]'), preview);
  }

  document.getElementById('contact-link-add').addEventListener('click', function () {
    var holder = document.createElement('tbody');

    holder.innerHTML = tpl.innerHTML.replace(/__N__/g, String(next++));
    body.appendChild(holder.firstElementChild);
    boot(body);
  });

  body.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-ocs-remove]');

    if (btn) {
      body.removeChild(btn.closest('tr'));
    }
  });

  body.addEventListener('change', function (e) {
    if (e.target.hasAttribute('data-ocs-icon')) {
      preview(e.target);
    }
  });

  boot(body);
}());
//--></script>
          </fieldset>
          <fieldset>
            <legend>{{ text_top_menu }}</legend>
            <p class="help-block">{{ help_top_menu }}</p>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-top-enabled">{{ entry_top_enabled }}</label>
              <div class="col-sm-10">
                <select name="theme_ocs_top_menu[enabled]" id="input-top-enabled" class="form-control">
                  <option value="1"{% if top.enabled %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not top.enabled %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_top_title }}</label>
              <div class="col-sm-10">
                {% for language in languages %}<input type="text" name="theme_ocs_top_menu[title][{{ language.code }}]" value="{{ top.title[language.code] }}" maxlength="60" placeholder="{{ language.name }}" class="form-control" />{% endfor %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_top_items }}</label>
              <div class="col-sm-10">
                <label class="checkbox-inline"><input type="checkbox" name="theme_ocs_top_menu[sale]" value="1"{% if top.sale %} checked="checked"{% endif %} /> {{ text_top_sale }}</label>
                <label class="checkbox-inline"><input type="checkbox" name="theme_ocs_top_menu[blog]" value="1"{% if top.blog %} checked="checked"{% endif %} /> {{ text_top_blog }}</label>
                <label class="checkbox-inline"><input type="checkbox" name="theme_ocs_top_menu[contacts]" value="1"{% if top.contacts %} checked="checked"{% endif %} /> {{ text_top_contacts }}</label>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_top_pages }}</label>
              <div class="col-sm-10">
                <div class="table-responsive">
                  <table class="table table-bordered">
                    <thead><tr><td style="width: 60px">{{ column_show }}</td><td>{{ column_title }}</td><td style="width: 110px">{{ column_sort }}</td></tr></thead>
                    <tbody>
                    {% for page in top_pages %}
                    <tr>
                      <td class="text-center"><input type="checkbox" name="theme_ocs_top_menu[pages][{{ page.id }}][on]" value="1"{% if top.pages[page.id].on %} checked="checked"{% endif %} /></td>
                      <td>{{ page.title }}</td>
                      <td><input type="text" name="theme_ocs_top_menu[pages][{{ page.id }}][sort]" value="{{ top.pages[page.id].sort }}" class="form-control" /></td>
                    </tr>
                    {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_info_blocks }}</legend>
            <p class="help-block">{{ help_info_blocks }}</p>
            <div class="table-responsive">
              <table class="table table-bordered" id="info-blocks">
                <thead><tr><td>{{ column_icon }}</td><td>{{ column_title }}</td><td>{{ column_text }}</td><td>{{ column_url }}</td><td>{{ column_sort }}</td><td></td></tr></thead>
                <tbody>
                {% for block in info_blocks %}
                <tr>
                  <td><select name="theme_ocs_info_blocks[{{ loop.index0 }}][icon]" class="form-control">{% for icon in info_icons %}<option value="{{ icon }}"{% if block.icon == icon %} selected="selected"{% endif %}>{{ icon|capitalize }}</option>{% endfor %}</select></td>
                  <td>{% for language in languages %}<input type="text" name="theme_ocs_info_blocks[{{ loop.index0 }}][title][{{ language.code }}]" value="{{ block.title[language.code] }}" maxlength="80" placeholder="{{ language.name }}" class="form-control" />{% endfor %}</td>
                  <td>{% for language in languages %}<textarea name="theme_ocs_info_blocks[{{ loop.index0 }}][text][{{ language.code }}]" rows="2" maxlength="500" placeholder="{{ language.name }}" class="form-control">{{ block.text[language.code] }}</textarea>{% endfor %}</td>
                  <td><input type="text" name="theme_ocs_info_blocks[{{ loop.index0 }}][url]" value="{{ block.url }}" maxlength="500" placeholder="https://" class="form-control" /></td>
                  <td><input type="text" name="theme_ocs_info_blocks[{{ loop.index0 }}][sort]" value="{{ block.sort }}" class="form-control" style="min-width: 70px" /></td>
                  <td class="text-right"><button type="button" class="btn btn-danger" data-ocs-remove title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>
                </tr>
                {% endfor %}
                </tbody>
                <tfoot><tr><td colspan="6" class="text-right"><button type="button" id="info-block-add" class="btn btn-primary" title="{{ button_add }}"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot>
              </table>
            </div>
            <script type="text/template" id="info-block-template">
              <tr>
                  <td><select name="theme_ocs_info_blocks[__N__][icon]" class="form-control">{% for icon in info_icons %}<option value="{{ icon }}"{% if x.icon == icon %} selected="selected"{% endif %}>{{ icon|capitalize }}</option>{% endfor %}</select></td>
                  <td>{% for language in languages %}<input type="text" name="theme_ocs_info_blocks[__N__][title][{{ language.code }}]" value="{{ x.title[language.code] }}" maxlength="80" placeholder="{{ language.name }}" class="form-control" />{% endfor %}</td>
                  <td>{% for language in languages %}<textarea name="theme_ocs_info_blocks[__N__][text][{{ language.code }}]" rows="2" maxlength="500" placeholder="{{ language.name }}" class="form-control">{{ x.text[language.code] }}</textarea>{% endfor %}</td>
                  <td><input type="text" name="theme_ocs_info_blocks[__N__][url]" value="{{ x.url }}" maxlength="500" placeholder="https://" class="form-control" /></td>
                  <td><input type="text" name="theme_ocs_info_blocks[__N__][sort]" value="{{ x.sort }}" class="form-control" style="min-width: 70px" /></td>
                  <td class="text-right"><button type="button" class="btn btn-danger" data-ocs-remove title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>
                </tr>
            </script>
            <script type="text/javascript"><!--
(function () {
  var body = document.querySelector('#info-blocks tbody');
  var tpl = document.getElementById('info-block-template');
  var next = body.children.length;

  document.getElementById('info-block-add').addEventListener('click', function () {
    var holder = document.createElement('tbody');

    if (body.children.length >= 10) {
      return;
    }

    holder.innerHTML = tpl.innerHTML.replace(/__N__/g, String(next++));
    body.appendChild(holder.firstElementChild);
  });

  body.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-ocs-remove]');

    if (btn) {
      body.removeChild(btn.closest('tr'));
    }
  });
}());
//--></script>
          </fieldset>
          <fieldset>
            <legend>{{ text_image }}</legend>
            {% for role in roles %}
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-image-{{ role }}-width">{{ attribute(_context, 'entry_image_' ~ role) }}</label>
              <div class="col-sm-10">
                <div class="row">
                  <div class="col-sm-3"><input type="text" name="theme_ocs_image_{{ role }}_width" value="{{ attribute(_context, 'theme_ocs_image_' ~ role ~ '_width') }}" placeholder="{{ entry_width }}" id="input-image-{{ role }}-width" class="form-control" /></div>
                  <div class="col-sm-3"><input type="text" name="theme_ocs_image_{{ role }}_height" value="{{ attribute(_context, 'theme_ocs_image_' ~ role ~ '_height') }}" placeholder="{{ entry_height }}" class="form-control" /></div>
                </div>
                {% if attribute(_context, 'error_image_' ~ role) %}<div class="text-danger">{{ attribute(_context, 'error_image_' ~ role) }}</div>{% endif %}
              </div>
            </div>
            {% endfor %}
          </fieldset>
        </form>
