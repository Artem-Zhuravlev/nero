{# Extension: ocs_product_extras. Admin settings and question moderation. Owner: SPEC-035. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-extras" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-extras" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-9">
              <select name="module_ocs_product_extras_status" id="input-status" class="form-control">
                <option value="1"{% if module_ocs_product_extras_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_product_extras_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-attrs"><span data-toggle="tooltip" title="{{ help_attrs }}">{{ entry_key_attrs }}</span></label>
            <div class="col-sm-9"><input type="text" name="module_ocs_product_extras_key_attrs" value="{{ module_ocs_product_extras_key_attrs }}" id="input-attrs" class="form-control" placeholder="12, 15, 18" />
              {% if error_attrs %}<div class="text-danger">{{ error_attrs }}</div>{% endif %}</div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-questions">{{ entry_questions }}</label>
            <div class="col-sm-9">
              <select name="module_ocs_product_extras_questions" id="input-questions" class="form-control">
                <option value="1"{% if module_ocs_product_extras_questions %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_product_extras_questions %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-accessories">{{ entry_accessories }}</label>
            <div class="col-sm-9">
              <select name="module_ocs_product_extras_accessories" id="input-accessories" class="form-control">
                <option value="1"{% if module_ocs_product_extras_accessories %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_product_extras_accessories %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-similar">{{ entry_similar }}</label>
            <div class="col-sm-9">
              <select name="module_ocs_product_extras_similar" id="input-similar" class="form-control">
                <option value="1"{% if module_ocs_product_extras_similar %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_product_extras_similar %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-limit">{{ entry_similar_limit }}</label>
            <div class="col-sm-9"><input type="text" name="module_ocs_product_extras_similar_limit" value="{{ module_ocs_product_extras_similar_limit }}" id="input-limit" class="form-control" />
              {% if error_limit %}<div class="text-danger">{{ error_limit }}</div>{% endif %}</div>
          </div>
        </form>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-comments"></i> {{ text_questions }} ({{ total }}, {{ text_pending }}: {{ pending }})</h3></div>
      <div class="panel-body">
        {% for q in questions %}
        <form action="{{ action }}" method="post" class="well well-sm">
          <input type="hidden" name="question_id" value="{{ q.question_id }}" />
          <p><strong>{{ q.name }}</strong> {{ q.email }} &middot; <a href="{{ q.product_url }}" target="_blank">{{ q.product }}</a> &middot; {{ q.date_added }}
            {% if q.status %}<span class="label label-success">{{ text_published }}</span>{% else %}<span class="label label-warning">{{ text_waiting }}</span>{% endif %}</p>
          <p>{{ q.text }}</p>
          <textarea name="answer" rows="3" class="form-control" placeholder="{{ entry_answer }}">{{ q.answer }}</textarea>
          <div style="margin-top: 8px">
            <label class="checkbox-inline"><input type="checkbox" name="publish" value="1"{% if q.status %} checked="checked"{% endif %} /> {{ text_published }}</label>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-save"></i> {{ button_save }}</button>
            <button type="submit" name="delete" value="1" class="btn btn-danger btn-sm" onclick="return confirm('{{ text_confirm }}');"><i class="fa fa-trash-o"></i></button>
          </div>
        </form>
        {% else %}
        <p class="text-center">{{ text_none }}</p>
        {% endfor %}
        <div class="row"><div class="col-sm-12 text-left">{{ pagination }}</div></div>
        <p class="text-muted">ocs_product_extras v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
