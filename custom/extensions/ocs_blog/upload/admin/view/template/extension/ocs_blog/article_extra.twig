{# Extension ocs_blog (SPEC-084): author, publication date and reactions of the article; printed inside the "Data" tab by the OCMOD. #}
<div class="form-group">
  <label class="col-sm-2 control-label" for="input-ocs-blog-author">{{ entry_author }}</label>
  <div class="col-sm-10">
    <select name="ocs_blog_author_id" id="input-ocs-blog-author" class="form-control">
      <option value="0">{{ text_none }}</option>
      {% for author in authors %}
      <option value="{{ author.author_id }}"{% if author.author_id == author_id %} selected="selected"{% endif %}>{{ author.name }}</option>
      {% endfor %}
    </select>
  </div>
</div>
<div class="form-group">
  <label class="col-sm-2 control-label" for="input-ocs-blog-date"><span data-toggle="tooltip" title="{{ help_date }}">{{ entry_date }}</span></label>
  <div class="col-sm-3">
    <input type="date" name="ocs_blog_date" value="{{ date }}" id="input-ocs-blog-date" class="form-control" />
  </div>
  {% if show_reactions %}
  <div class="col-sm-7"><p class="form-control-static text-muted">{{ text_reactions }}: <i class="fa fa-thumbs-o-up"></i> {{ likes }} &nbsp; <i class="fa fa-thumbs-o-down"></i> {{ dislikes }}</p></div>
  {% endif %}
</div>
