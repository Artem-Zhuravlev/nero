{# Extension: ocs_stickers. Admin settings and sticker list. Owner: SPEC-029. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="submit" form="form-stickers" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-success"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if warning %}<div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cog"></i> {{ text_settings }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-stickers" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-4">
              <select name="module_ocs_stickers_status" id="input-status" class="form-control">
                <option value="1"{% if module_ocs_stickers_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_stickers_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-limit"><span data-toggle="tooltip" title="{{ help_limit }}">{{ entry_limit }}</span></label>
            <div class="col-sm-4"><input type="number" name="module_ocs_stickers_limit" value="{{ module_ocs_stickers_limit }}" id="input-limit" min="1" max="5" class="form-control" /></div>
          </div>
        </form>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-tags"></i> {{ text_list }}</h3></div>
      <div class="panel-body table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr><td>{{ column_name }}</td><td>{{ column_position }}</td><td>{{ column_priority }}</td><td>{{ column_rule }}</td><td>{{ column_assigned }}</td><td>{{ column_status }}</td><td></td></tr>
          </thead>
          <tbody>
            {% for s in stickers %}
            <tr>
              <td><span class="label" style="background: {{ s.bg }}; color: {{ s.fg }}; padding: 4px 10px; font-size: 12px;">{{ s.name }}</span></td>
              <td>{{ s.position }}</td>
              <td>{{ s.priority }}</td>
              <td>{{ s.rule }}</td>
              <td>{{ s.assigned }}</td>
              <td>{{ s.status }}</td>
              <td class="text-right">
                <a href="{{ s.edit }}" class="btn btn-primary btn-sm" data-toggle="tooltip" title="{{ button_edit }}"><i class="fa fa-pencil"></i></a>
                <form action="{{ action }}" method="post" style="display: inline;" onsubmit="return confirm('{{ text_confirm }}');">
                  <input type="hidden" name="delete_id" value="{{ s.sticker_id }}" />
                  <button type="submit" class="btn btn-danger btn-sm"><i class="fa fa-trash-o"></i></button>
                </form>
              </td>
            </tr>
            {% else %}
            <tr><td class="text-center" colspan="7">{{ text_no_results }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        <p class="text-muted">ocs_stickers v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
