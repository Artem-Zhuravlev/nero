{# Extension: ocs_stickers. Add / edit one sticker. Owner: SPEC-029. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-sticker" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-sticker" class="form-horizontal">
          {% for language in languages %}
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name{{ language.language_id }}">{{ entry_name }} ({{ language.code }})</label>
            <div class="col-sm-10"><input type="text" name="name[{{ language.language_id }}]" value="{{ names[language.language_id] }}" id="input-name{{ language.language_id }}" maxlength="32" class="form-control" /></div>
          </div>
          {% endfor %}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-fg">{{ entry_text_color }}</label>
            <div class="col-sm-4"><input type="color" name="text_color" value="{{ text_color }}" id="input-fg" class="form-control" /></div>
            <label class="col-sm-2 control-label" for="input-bg">{{ entry_bg_color }}</label>
            <div class="col-sm-4"><input type="color" name="bg_color" value="{{ bg_color }}" id="input-bg" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-position">{{ entry_position }}</label>
            <div class="col-sm-4">
              <select name="position" id="input-position" class="form-control">
                {% for p in positions %}<option value="{{ p }}"{% if position == p %} selected="selected"{% endif %}>{{ attribute(_context, 'text_pos_' ~ p) }}</option>{% endfor %}
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-priority"><span data-toggle="tooltip" title="{{ help_priority }}">{{ entry_priority }}</span></label>
            <div class="col-sm-4"><input type="number" name="priority" value="{{ priority }}" id="input-priority" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-rule"><span data-toggle="tooltip" title="{{ help_rule }}">{{ entry_rule }}</span></label>
            <div class="col-sm-4">
              <select name="rule_type" id="input-rule" class="form-control">
                {% for r in rules %}<option value="{{ r }}"{% if rule_type == r %} selected="selected"{% endif %}>{{ attribute(_context, 'text_rule_' ~ r) }}</option>{% endfor %}
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-value"><span data-toggle="tooltip" title="{{ help_value }}">{{ entry_rule_value }}</span></label>
            <div class="col-sm-4"><input type="number" name="rule_value" value="{{ rule_value }}" id="input-value" min="0" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-pct">{{ entry_show_pct }}</label>
            <div class="col-sm-4">
              <select name="show_pct" id="input-pct" class="form-control">
                <option value="1"{% if show_pct %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not show_pct %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-4">
              <select name="status" id="input-status" class="form-control">
                <option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-category"><span data-toggle="tooltip" title="{{ help_scope }}">{{ entry_category_id }}</span></label>
            <div class="col-sm-4"><input type="number" name="category_id" value="{{ category_id }}" id="input-category" min="0" class="form-control" /></div>
            <label class="col-sm-2 control-label" for="input-manufacturer">{{ entry_manufacturer_id }}</label>
            <div class="col-sm-4"><input type="number" name="manufacturer_id" value="{{ manufacturer_id }}" id="input-manufacturer" min="0" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-products"><span data-toggle="tooltip" title="{{ help_products }}">{{ entry_products }}</span></label>
            <div class="col-sm-10"><textarea name="products" rows="3" id="input-products" class="form-control">{{ products }}</textarea></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
