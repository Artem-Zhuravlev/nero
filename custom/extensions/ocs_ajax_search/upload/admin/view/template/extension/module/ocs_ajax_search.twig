{# Extension: ocs_ajax_search. Admin settings form. Owner: SPEC-028. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-search" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-search" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_ocs_ajax_search_status" id="input-status" class="form-control">
                <option value="1"{% if module_ocs_ajax_search_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_ajax_search_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-limit">{{ entry_limit }}</label>
            <div class="col-sm-4"><input type="number" name="module_ocs_ajax_search_limit" value="{{ module_ocs_ajax_search_limit }}" id="input-limit" min="1" max="12" class="form-control" /></div>
            <label class="col-sm-2 control-label" for="input-min">{{ entry_min_length }}</label>
            <div class="col-sm-4"><input type="number" name="module_ocs_ajax_search_min_length" value="{{ module_ocs_ajax_search_min_length }}" id="input-min" min="1" max="5" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-categories">{{ entry_categories }}</label>
            <div class="col-sm-4">
              <select name="module_ocs_ajax_search_categories" id="input-categories" class="form-control">
                <option value="1"{% if module_ocs_ajax_search_categories %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_ajax_search_categories %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-brands">{{ entry_brands }}</label>
            <div class="col-sm-4">
              <select name="module_ocs_ajax_search_brands" id="input-brands" class="form-control">
                <option value="1"{% if module_ocs_ajax_search_brands %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_ajax_search_brands %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <fieldset>
            <legend>{{ text_per_language }}</legend>
            <ul class="nav nav-tabs">
              {% for language in languages %}
              <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
              {% endfor %}
            </ul>
            <div class="tab-content">
              {% for language in languages %}
              <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
                <br />
                <div class="form-group">
                  <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_popular }}">{{ entry_popular }}</span></label>
                  <div class="col-sm-10"><textarea name="module_ocs_ajax_search_l[{{ language.code }}][popular]" rows="6" class="form-control">{{ l[language.code].popular }}</textarea></div>
                </div>
              </div>
              {% endfor %}
            </div>
          </fieldset>
        </form>
        <p class="text-muted">ocs_ajax_search v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
