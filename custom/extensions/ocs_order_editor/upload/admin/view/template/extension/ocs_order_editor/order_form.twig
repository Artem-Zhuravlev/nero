{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ ocs_oe_cancel }}</a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div id="oe-alerts"></div>
    <div id="oe-root" class="oe"></div>
  </div>
</div>
<link rel="stylesheet" type="text/css" href="view/stylesheet/ocs_order_editor/order_editor.css?v={{ ocs_oe_version }}" />
<script type="application/json" id="oe-config">{{ ocs_oe_config }}</script>
<script type="text/javascript" src="view/javascript/ocs_order_editor/order_editor.js?v={{ ocs_oe_version }}"></script>
{{ footer }}
