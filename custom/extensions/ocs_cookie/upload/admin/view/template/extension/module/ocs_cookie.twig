{# Extension: ocs_cookie. Admin settings form. Owner: SPEC-083. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-cookie" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cookie" class="form-horizontal">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-4">
                <select name="module_ocs_cookie_status" id="input-status" class="form-control">
                  <option value="1"{% if module_ocs_cookie_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_ocs_cookie_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
              <label class="col-sm-2 control-label" for="input-position">{{ entry_position }}</label>
              <div class="col-sm-4">
                <select name="module_ocs_cookie_position" id="input-position" class="form-control">
                  <option value="card"{% if module_ocs_cookie_position != 'bar' %} selected="selected"{% endif %}>{{ text_position_card }}</option>
                  <option value="bar"{% if module_ocs_cookie_position == 'bar' %} selected="selected"{% endif %}>{{ text_position_bar }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-version">{{ entry_version }}</label>
              <div class="col-sm-4"><input type="text" name="module_ocs_cookie_version" value="{{ module_ocs_cookie_version }}" id="input-version" class="form-control" /><div class="help-block">{{ help_version }}</div></div>
              <label class="col-sm-2 control-label" for="input-days">{{ entry_days }}</label>
              <div class="col-sm-4"><input type="text" name="module_ocs_cookie_days" value="{{ module_ocs_cookie_days }}" id="input-days" class="form-control" /></div>
              {% if error_number %}<div class="col-sm-offset-2 col-sm-10 text-danger">{{ error_number }}</div>{% endif %}
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_per_language }}</legend>
            {% if error_text %}<div class="text-danger">{{ error_text }}</div>{% endif %}
            <ul class="nav nav-tabs" id="language">
              {% for language in languages %}
              <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
              {% endfor %}
            </ul>
            <div class="tab-content">
              {% for language in languages %}
              <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
                <br />
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_title }}</label>
                  <div class="col-sm-10"><input type="text" name="module_ocs_cookie_l[{{ language.code }}][title]" value="{{ l[language.code].title }}" class="form-control" /></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_text }}</label>
                  <div class="col-sm-10"><textarea name="module_ocs_cookie_l[{{ language.code }}][text]" rows="4" class="form-control">{{ l[language.code].text }}</textarea><div class="help-block">{{ help_text }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_link_label }}</label>
                  <div class="col-sm-4"><input type="text" name="module_ocs_cookie_l[{{ language.code }}][link_label]" value="{{ l[language.code].link_label }}" class="form-control" /></div>
                  <label class="col-sm-2 control-label">{{ entry_link_url }}</label>
                  <div class="col-sm-4"><input type="text" name="module_ocs_cookie_l[{{ language.code }}][link_url]" value="{{ l[language.code].link_url }}" placeholder="/cookie-terms" class="form-control" /></div>
                  <div class="col-sm-offset-2 col-sm-10 help-block">{{ help_link }}</div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_accept }}</label>
                  <div class="col-sm-4"><input type="text" name="module_ocs_cookie_l[{{ language.code }}][accept]" value="{{ l[language.code].accept }}" class="form-control" /></div>
                  <label class="col-sm-2 control-label">{{ entry_necessary }}</label>
                  <div class="col-sm-4"><input type="text" name="module_ocs_cookie_l[{{ language.code }}][necessary]" value="{{ l[language.code].necessary }}" class="form-control" /></div>
                </div>
              </div>
              {% endfor %}
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
