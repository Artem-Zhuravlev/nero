{# Extension: ocs_credit. Admin plans and texts. Owner: SPEC-036. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-credit" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% for e in errors %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ e }}</div>{% endfor %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <form action="{{ action }}" method="post" id="form-credit" class="form-horizontal">
      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
        <div class="panel-body">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10"><select name="module_ocs_credit_status" id="input-status" class="form-control">
              <option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
              <option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option></select></div>
          </div>
          <p class="text-muted">{{ help_plans }}</p>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead><tr><td>{{ column_bank }}</td><td>{{ column_months }}</td><td>{{ column_rate }}</td><td>{{ column_fee }}</td><td>{{ column_min }}</td><td>{{ column_max }}</td></tr></thead>
              <tbody>
                {% for p in plans %}
                <tr>
                  <td><input type="text" name="plan[{{ loop.index0 }}][bank]" value="{{ p.bank }}" class="form-control" /></td>
                  <td><input type="text" name="plan[{{ loop.index0 }}][months]" value="{{ p.months }}" class="form-control" /></td>
                  <td><input type="text" name="plan[{{ loop.index0 }}][rate]" value="{{ p.rate }}" class="form-control" /></td>
                  <td><input type="text" name="plan[{{ loop.index0 }}][fee]" value="{{ p.fee }}" class="form-control" /></td>
                  <td><input type="text" name="plan[{{ loop.index0 }}][min]" value="{{ p.min }}" class="form-control" /></td>
                  <td><input type="text" name="plan[{{ loop.index0 }}][max]" value="{{ p.max }}" class="form-control" /></td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <ul class="nav nav-tabs">
            {% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#lang{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>{% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="lang{{ language.language_id }}"><br />
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_disclaimer }}</label>
                <div class="col-sm-10"><textarea name="module_ocs_credit_l[{{ language.code }}][disclaimer]" rows="2" class="form-control">{{ l[language.code].disclaimer }}</textarea></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_terms }}</label>
                <div class="col-sm-10"><textarea name="module_ocs_credit_l[{{ language.code }}][terms]" rows="8" class="form-control">{{ l[language.code].terms }}</textarea></div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </form>
    <p class="text-muted">ocs_credit v{{ version }}</p>
  </div>
</div>
{{ footer }}
