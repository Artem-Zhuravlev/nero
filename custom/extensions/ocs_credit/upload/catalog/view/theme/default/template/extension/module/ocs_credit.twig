{# Extension: ocs_credit. Instalment block of the product page (SPEC-036 REQ-CRD-001/002); recalculated by theme.js on option changes. #}
<div class="ocs-credit" data-ocs-credit="{{ config_json }}" aria-label="{{ text_title }}"{% if not any %} hidden{% endif %}>
  <h2 class="ocs-block-title">{{ text_title }}</h2>
  <ul class="list-unstyled ocs-credit-plans">
    {% for p in plans %}
    <li data-plan="{{ p.index }}"{% if not p.show %} hidden{% endif %}>
      <label><input type="radio" name="ocs-credit-plan" value="{{ p.index }}" />
        <strong>{{ p.bank }}</strong> &middot; {{ p.months }} {{ text_months }} &middot; <span class="ocs-credit-pay">{{ p.pay }}</span> {{ text_per_month }}</label>
    </li>
    {% endfor %}
  </ul>
  <p class="ocs-credit-disclaimer text-muted">{{ disclaimer }}</p>
  {% if terms %}
  <button type="button" class="btn btn-link ocs-credit-details" data-ocs-credit-details="1">{{ text_details }}</button>
  <div class="ocs-credit-terms" hidden data-close="{{ text_close }}"><h3 id="ocs-credit-title">{{ text_title }}</h3>{{ terms }}</div>
  {% endif %}
</div>
