{# Extension: ocs_super_search. Admin settings, synonyms and index rebuild. Owner: SPEC-079. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-super-search" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if not built_at %}
    <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_not_built }}</div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-super-search" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-4">
              <select name="module_ocs_super_search_status" id="input-status" class="form-control">
                <option value="1"{% if module_ocs_super_search_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_super_search_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-min">{{ entry_min_length }}</label>
            <div class="col-sm-4"><input type="number" name="module_ocs_super_search_min_length" value="{{ module_ocs_super_search_min_length }}" id="input-min" min="1" max="5" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-layout"><span data-toggle="tooltip" title="{{ help_layout }}">{{ entry_layout }}</span></label>
            <div class="col-sm-4">
              <select name="module_ocs_super_search_layout" id="input-layout" class="form-control">
                <option value="1"{% if module_ocs_super_search_layout %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_super_search_layout %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-translit"><span data-toggle="tooltip" title="{{ help_translit }}">{{ entry_translit }}</span></label>
            <div class="col-sm-4">
              <select name="module_ocs_super_search_translit" id="input-translit" class="form-control">
                <option value="1"{% if module_ocs_super_search_translit %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_super_search_translit %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-typo"><span data-toggle="tooltip" title="{{ help_typo }}">{{ entry_typo }}</span></label>
            <div class="col-sm-4">
              <select name="module_ocs_super_search_typo" id="input-typo" class="form-control">
                <option value="1"{% if module_ocs_super_search_typo %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_super_search_typo %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-ttl"><span data-toggle="tooltip" title="{{ help_cache_ttl }}">{{ entry_cache_ttl }}</span></label>
            <div class="col-sm-4"><input type="number" name="module_ocs_super_search_cache_ttl" value="{{ module_ocs_super_search_cache_ttl }}" id="input-ttl" min="0" max="86400" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-synonyms">{{ entry_synonyms }}</label>
            <div class="col-sm-10">
              <textarea name="module_ocs_super_search_synonyms" id="input-synonyms" rows="8" class="form-control" placeholder="{{ placeholder_synonyms|escape }}">{{ module_ocs_super_search_synonyms|escape }}</textarea>
              <div class="help-block">{{ help_synonyms }}</div>
            </div>
          </div>
        </form>
        <fieldset>
          <legend>{{ text_index }}</legend>
          <div class="form-group">
            <div class="col-sm-12">
              <p id="ss-state">{% if built_at %}{{ text_built }} <b>{{ built_at }}</b> &middot; {{ text_tokens }} <b>{{ tokens }}</b>{% else %}{{ text_not_built }}{% endif %}</p>
              <button type="button" id="ss-rebuild" class="btn btn-warning"><i class="fa fa-refresh"></i> {{ button_rebuild }}</button>
              <span id="ss-progress" class="text-muted" style="margin-left:10px"></span>
              <p class="help-block">{{ help_rebuild }}</p>
            </div>
          </div>
        </fieldset>
        <p class="text-muted">ocs_super_search v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var ssTexts = {
  built: {{ text_built|json_encode|raw }},
  tokens: {{ text_tokens|json_encode|raw }},
  rebuilt: {{ text_rebuilt|json_encode|raw }},
  error: {{ error_rebuild|json_encode|raw }}
};
$('#ss-rebuild').on('click', function () {
  var button = $(this), progress = $('#ss-progress'), done = 0;
  button.prop('disabled', true);
  function step(after) {
    $.getJSON('{{ rebuild }}&after=' + after, function (json) {
      if (json.error) {
        progress.text(json.error);
        button.prop('disabled', false);
        return;
      }
      done += json.processed;
      progress.text(done + ' / ' + json.total);
      if (json.done) {
        $('#ss-state').empty().append(document.createTextNode(ssTexts.built + ' ' + json.built_at + ' · ' + ssTexts.tokens + ' ' + json.tokens));
        progress.text(ssTexts.rebuilt);
        button.prop('disabled', false);
      } else {
        step(json.after);
      }
    }).fail(function () {
      progress.text(ssTexts.error);
      button.prop('disabled', false);
    });
  }
  step(0);
});
//--></script>
{{ footer }}
