{# Extension: ocs_product_carousel. Product cards in a swiper carousel (SPEC-033 REQ-HOM-020), optional category tabs (SPEC-039 REQ-VIS-003). #}
<section class="ocs-pcarousel{% if panels %} has-tabs{% endif %}" id="{{ uid }}" aria-label="{{ heading_title|striptags }}">
  <div class="ocs-pcarousel-head">
    <h3 class="ocs-sec-title">{{ heading_title }}</h3>
    {% if show_all and not panels %}<a href="{{ show_all }}" class="ocs-more">{{ text_show_all }} <svg class="ocs-i ocs-i-sm" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>{% endif %}
  </div>
  {% if panels %}
  <div class="ocs-chips ocs-tabs" role="tablist">
    {% for p in panels %}<button type="button" role="tab" class="ocs-chip{% if loop.first %} is-active{% endif %}" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-ocs-tab="{{ loop.index0 }}">{{ p.label }}</button>{% endfor %}
  </div>
  {% endif %}
  {% for list in lists %}
  <div class="ocs-tab-panel"{% if panels %} role="tabpanel" data-ocs-panel="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}{% endif %}>
    <div class="ocs-carousel" role="region" aria-label="{{ list.label ? list.label : heading_title|striptags }}">
      <div class="ocs-carousel-track">
        {% for product in list.products %}
        <div class="ocs-carousel-item">
          {% include 'ocs/template/ocs/card.twig' %}
        </div>
        {% endfor %}
      </div>
      <button type="button" class="ocs-carousel-prev" aria-label="{{ text_prev }}">&lsaquo;</button>
      <button type="button" class="ocs-carousel-next" aria-label="{{ text_next }}">&rsaquo;</button>
    </div>
    {% if list.href %}<a href="{{ list.href }}" class="ocs-more ocs-more-bottom">{{ text_show_all }} <svg class="ocs-i ocs-i-sm" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>{% endif %}
  </div>
  {% endfor %}
</section>
