{# Extension: ocs_city. Order tracking page (SPEC-032 REQ-CTY-030). Form posts back to the page; nothing is shown without a matching second factor. #}
{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="{% if column_left and column_right %}col-sm-6{% elseif column_left or column_right %}col-sm-9{% else %}col-sm-12{% endif %}">{{ content_top }}
      <h1>{{ track_title }}</h1>
      <p>{{ track_intro }}</p>
      {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
      <form action="{{ action }}" method="post" class="ocs-track-form">
        <input type="hidden" name="token" value="{{ token }}" />
        <input type="text" name="order_id" value="{{ order_id }}" class="form-control" placeholder="{{ track_order }}" aria-label="{{ track_order }}" inputmode="numeric" required />
        <input type="text" name="contact" value="{{ contact }}" class="form-control" placeholder="{{ track_contact }}" aria-label="{{ track_contact }}" autocomplete="off" required />
        <button type="submit" class="btn btn-primary">{{ track_button }}</button>
      </form>
      {% if result %}
      <div class="ocs-track-result">
        <h3>#{{ result.order_id }} &middot; {{ track_placed }} {{ result.date }}</h3>
        <p><strong>{{ track_status }}</strong> {{ result.status }}</p>
        <h4>{{ track_history }}</h4>
        <ul class="list-unstyled">
          {% for h in result.history %}<li>{{ h.date }} &mdash; {{ h.status }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
