{# Extension: ocs_city. City popup body (OCS.modal, SPEC-032 REQ-CTY-002). #}
<div class="ocs-city-select" data-close="{{ text_close }}">
  <h3 id="ocs-city-title">{{ title }}</h3>
  <input type="search" class="form-control ocs-city-search" placeholder="{{ search }}" aria-label="{{ search }}" autocomplete="off" />
  <ul class="list-unstyled ocs-city-list">
    {% for c in cities %}
    <li><button type="button" class="ocs-city-choice{% if c.current %} is-current{% endif %}" data-city="{{ c.city_id }}">{{ c.name }}</button></li>
    {% endfor %}
  </ul>
</div>
