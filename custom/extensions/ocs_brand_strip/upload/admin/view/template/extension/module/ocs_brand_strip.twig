{# Extension: ocs_brand_strip. Admin settings form. Owner: SPEC-033. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-brands" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-brands" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_ocs_brand_strip_status" id="input-status" class="form-control">
                <option value="1"{% if module_ocs_brand_strip_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_ocs_brand_strip_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-source">{{ entry_source }}</label>
            <div class="col-sm-4">
              <select name="module_ocs_brand_strip_source" id="input-source" class="form-control">
                <option value="all"{% if module_ocs_brand_strip_source == 'all' %} selected="selected"{% endif %}>{{ text_source_all }}</option>
                <option value="selected"{% if module_ocs_brand_strip_source == 'selected' %} selected="selected"{% endif %}>{{ text_source_selected }}</option>
              </select>
            </div>
            <label class="col-sm-2 control-label" for="input-sort">{{ entry_sort }}</label>
            <div class="col-sm-4">
              <select name="module_ocs_brand_strip_sort" id="input-sort" class="form-control">
                <option value="name"{% if module_ocs_brand_strip_sort == 'name' %} selected="selected"{% endif %}>{{ text_sort_name }}</option>
                <option value="sort"{% if module_ocs_brand_strip_sort == 'sort' %} selected="selected"{% endif %}>{{ text_sort_order }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-selected"><span data-toggle="tooltip" title="{{ help_selected }}">{{ entry_selected }}</span></label>
            <div class="col-sm-10"><input type="text" name="module_ocs_brand_strip_selected" value="{{ module_ocs_brand_strip_selected }}" id="input-selected" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-limit">{{ entry_limit }}</label>
            <div class="col-sm-2"><input type="number" name="module_ocs_brand_strip_limit" value="{{ module_ocs_brand_strip_limit }}" id="input-limit" min="1" max="60" class="form-control" /></div>
            <label class="col-sm-2 control-label">{{ entry_size }}</label>
            <div class="col-sm-2"><input type="number" name="module_ocs_brand_strip_width" value="{{ module_ocs_brand_strip_width }}" class="form-control" /></div>
            <div class="col-sm-2"><input type="number" name="module_ocs_brand_strip_height" value="{{ module_ocs_brand_strip_height }}" class="form-control" /></div>
          </div>
        </form>
        <p class="text-muted">{{ help_images }}</p>
        <p class="text-muted">ocs_brand_strip v{{ version }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
