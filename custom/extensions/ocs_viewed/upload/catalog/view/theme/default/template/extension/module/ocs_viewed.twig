{# Extension: ocs_viewed. Recently viewed block; the cards are the shared listing partial of the ocs theme (SPEC-030 REQ-VWD-002). #}
<section class="ocs-viewed">
  <div class="ocs-sec-title">{{ heading_title }}</div>
  {# SPEC-106: a carousel on phones (2 cards per view), the card grid from 768px #}
  <div class="ocs-carousel ocs-mc" role="region" aria-label="{{ heading_title|striptags }}">
    <div class="ocs-carousel-track">
      {% for product in products %}
      <div class="ocs-carousel-item">{% include 'ocs/template/ocs/card.twig' %}</div>
      {% endfor %}
    </div>
  </div>
</section>
