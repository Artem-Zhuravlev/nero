{# Extension: ocs_home_slider. Add / edit one slide. Owner: SPEC-033. #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-slide" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-slide" class="form-horizontal">
          {% for language in languages %}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-title{{ language.language_id }}">{{ entry_title }} ({{ language.code }})</label>
            <div class="col-sm-4"><input type="text" name="description[{{ language.language_id }}][title]" value="{{ descriptions[language.language_id].title }}" id="input-title{{ language.language_id }}" maxlength="128" class="form-control" /></div>
            <label class="col-sm-2 control-label">{{ entry_text }} ({{ language.code }})</label>
            <div class="col-sm-4"><input type="text" name="description[{{ language.language_id }}][text]" value="{{ descriptions[language.language_id].text }}" maxlength="255" class="form-control" /></div>
          </div>
          {% endfor %}
          <div class="form-group required">
            <label class="col-sm-2 control-label">{{ entry_image }}</label>
            <div class="col-sm-4"><a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_image }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="image" value="{{ image }}" id="input-image" /></div>
            <label class="col-sm-2 control-label">{{ entry_image_mobile }}</label>
            <div class="col-sm-4"><a href="" id="thumb-image-mobile" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_image_mobile }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="image_mobile" value="{{ image_mobile }}" id="input-image-mobile" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-link"><span data-toggle="tooltip" title="{{ help_link }}">{{ entry_link }}</span></label>
            <div class="col-sm-4"><input type="text" name="link" value="{{ link }}" id="input-link" class="form-control" /></div>
            <label class="col-sm-2 control-label" for="input-sort">{{ entry_sort }}</label>
            <div class="col-sm-4"><input type="number" name="sort_order" value="{{ sort_order }}" id="input-sort" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-from"><span data-toggle="tooltip" title="{{ help_dates }}">{{ entry_date_from }}</span></label>
            <div class="col-sm-4"><input type="text" name="date_from" value="{{ date_from }}" id="input-from" placeholder="YYYY-MM-DD" class="form-control" /></div>
            <label class="col-sm-2 control-label" for="input-to">{{ entry_date_to }}</label>
            <div class="col-sm-4"><input type="text" name="date_to" value="{{ date_to }}" id="input-to" placeholder="YYYY-MM-DD" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-4">
              <select name="status" id="input-status" class="form-control">
                <option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
