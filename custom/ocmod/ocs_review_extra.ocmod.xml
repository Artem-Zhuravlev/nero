<?xml version="1.0" encoding="utf-8"?>
<!--
  Purpose: adds editable pros, cons and admin reply form groups after the text group of the admin review form.
  Owner: SPEC-049 (REQ-REV-005), SPEC-116 (REQ-REV-030). Event insufficient because: view events can add variables but not new markup to the core template.
  The groups are rendered by the ocs_product_extras admin event and handed over as {{ ocs_review_extra }}.
  Regex anchor: the text group ends after its error_text block; a plain search cannot reach past the group's closing tags.
  @core-file admin/view/template/catalog/review_form.twig
  @core-version 3.0.3.7
-->
<modification>
  <name>Nero review extras: pros, cons and admin reply in the admin review form</name>
  <code>ocs_review_extra</code>
  <version>1.1.0</version>
  <author>Nero</author>
  <link></link>
  <file path="admin/view/template/catalog/review_form.twig">
    <operation>
      <search regex="true"><![CDATA[~\{\{ error_text \}\}</div>\s*\{% endif %\} </div>\s*</div>~]]></search>
      <add position="after"><![CDATA[{{ ocs_review_extra }}]]></add>
    </operation>
  </file>
</modification>
