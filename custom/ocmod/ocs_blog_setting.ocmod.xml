<?xml version="1.0" encoding="utf-8"?>
<!--
  Purpose: per-language name, H1 and meta fields in the admin blog settings form (the core fields have no language).
  Owner: SPEC-084 (REQ-BLG-020). Event insufficient because: view events can add variables but not new markup to the core template.
  The language tabs are rendered by the ocs_blog admin event as {{ ocs_blog_lang_fields }}; the old single fields stay in a hidden
  wrapper so the form keeps posting them (the save event refills them from the default language).
  @core-file admin/view/template/blog/setting.twig
  @core-version 3.0.3.7
-->
<modification>
  <name>OCS blog: multilingual blog settings</name>
  <code>ocs_blog_setting</code>
  <version>1.0.0</version>
  <author>OCS</author>
  <link></link>
  <file path="admin/view/template/blog/setting.twig">
    <operation>
      <search><![CDATA[<div class="tab-pane active" id="tab-general">]]></search>
      <add position="after"><![CDATA[{{ ocs_blog_lang_fields }}<div style="display:none" aria-hidden="true">]]></add>
    </operation>
    <operation>
      <search><![CDATA[<div class="tab-pane" id="tab-option">]]></search>
      <add position="before"><![CDATA[</div>]]></add>
    </operation>
  </file>
</modification>
