{# @core-file catalog/view/theme/default/template/common/language.twig @core-version 3.0.3.7 #}
{% if languages|length > 1 %}
<div class="pull-left ocs-lang">
  <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-language">
    <div class="ocs-lang-list" role="group" aria-label="{{ text_language }}">
      {% for language in languages %}
      {% if not loop.first %}<span class="ocs-lang-sep" aria-hidden="true">|</span>{% endif %}
      {% if language.code == code %}<strong class="ocs-lang-cur" aria-current="true" title="{{ language.name }}">{{ language.name|slice(0, 3) }}</strong>{% else %}<button class="ocs-lang-btn language-select" type="button" name="{{ language.code }}" title="{{ language.name }}" aria-label="{{ language.name }}">{{ language.name|slice(0, 3) }}</button>{% endif %}
      {% endfor %}
    </div>
    <input type="hidden" name="code" value="" />
    <input type="hidden" name="redirect" value="{{ redirect }}" />
  </form>
</div>
{% endif %}
