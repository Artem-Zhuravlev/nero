{# @core-file catalog/view/theme/default/template/common/header.twig @core-version 3.0.3.7 #}
<!DOCTYPE html>
<!--[if IE]><![endif]-->
<!--[if IE 8 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie8"><![endif]-->
<!--[if IE 9 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie9"><![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html dir="{{ direction }}" lang="{{ lang }}">
<!--<![endif]-->
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ title }}</title>
{% if robots %}
<meta name="robots" content="{{ robots }}" />
{% endif %}
<base href="{{ base }}" />
{% if description %}
<meta name="description" content="{{ description }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}" />
{% endif %}
<meta property="og:title" content="{{ title }}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="{{ og_url }}" />
{% if og_image %}
<meta property="og:image" content="{{ og_image }}" />
{% else %}
<meta property="og:image" content="{{ logo }}" />
{% endif %}
<meta property="og:site_name" content="{{ name }}" />
<script src="catalog/view/javascript/jquery/jquery-2.1.1.min.js" type="text/javascript"></script>
<!-- Bootstrap 3 CSS is imported into the lowest cascade layer by the theme stylesheet (SPEC-038) -->
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
<!-- Font Awesome CSS is imported into the lowest cascade layer by the theme stylesheet (SPEC-039) -->
<link rel="preload" href="catalog/view/theme/ocs/fonts/gilroy-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="catalog/view/theme/ocs/fonts/gilroy-bold.woff2" as="font" type="font/woff2" crossorigin>
<link href="catalog/view/theme/ocs/stylesheet/stylesheet.css?v={{ asset_version }}" rel="stylesheet">
<!-- Swiper CSS is imported into the lowest cascade layer by the theme stylesheet (SPEC-038) -->
<script src="catalog/view/javascript/jquery/swiper/js/swiper.jquery.min.js" type="text/javascript"></script>
{% for style in styles %}
{% if 'jquery/swiper/css/swiper' not in style.href %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endif %}
{% endfor %}
{% for script in scripts %}
{% if 'jquery/swiper/js/swiper' not in script %}
<script src="{{ script }}" type="text/javascript"></script>
{% endif %}
{% endfor %}
<script src="catalog/view/javascript/common.js" type="text/javascript"></script>
<script src="catalog/view/theme/ocs/javascript/theme.js?v={{ asset_version }}" type="text/javascript"></script>
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body{% if ocs_notify %} data-ocs-notify="{{ ocs_notify.form }}" data-ocs-notify-t="{{ ocs_notify.text }}"{% endif %}{% if ocs_cart %} data-ocs-cart="{{ ocs_cart.url }}"{% endif %}{% if ocs_bk %} data-ocs-bk="{{ ocs_bk.sync }}" data-ocs-bk-cart="{{ ocs_bk.cart }}" data-ocs-bk-ids="{{ ocs_bk.cart_ids }}" data-ocs-bk-days="{{ ocs_bk.days }}" data-ocs-bk-t="{{ ocs_bk.strings }}"{% endif %}>
{% include 'ocs/template/ocs/sprite.twig' %}
{% if ocs_topbar %}
<div class="ocs-announce ocs-announce--{{ ocs_topbar.bg }}{% if ocs_topbar.button %} ocs-announce--btn{% endif %}{% if ocs_topbar.closable %} ocs-announce--closable{% endif %}" id="ocs-announce" data-id="{{ ocs_topbar.id }}"{% if ocs_topbar.style %} style="{{ ocs_topbar.style }}"{% endif %} role="region" aria-label="{{ ocs_topbar.label }}">
  <div class="container">
    <div class="ocs-announce-row">
      <span class="ocs-announce-text">{% if ocs_topbar.href %}<a href="{{ ocs_topbar.href }}"{% if ocs_topbar.blank %} target="_blank" rel="noopener"{% endif %}>{{ ocs_topbar.text }}</a>{% else %}{{ ocs_topbar.text }}{% endif %}</span>
      {% if ocs_topbar.button %}<a class="ocs-announce-btn ocs-announce-btn--{{ ocs_topbar.button.style }}" href="{{ ocs_topbar.button.href }}"{% if ocs_topbar.blank %} target="_blank" rel="noopener"{% endif %}>{{ ocs_topbar.button.label }}</a>{% endif %}
    </div>
    {% if ocs_topbar.closable %}<button type="button" class="ocs-announce-close" aria-label="{{ ocs_topbar.close }}">&times;</button>{% endif %}
  </div>
</div>
{% elseif ocs_shell and ocs_shell.announcement %}
<div class="ocs-announce" id="ocs-announce" data-id="{{ ocs_shell.announcement.id }}" role="region" aria-label="{{ ocs_shell.t.ocs_announce }}">
  <div class="container">
    <span class="ocs-announce-text">{% if ocs_shell.announcement.href %}<a href="{{ ocs_shell.announcement.href }}">{{ ocs_shell.announcement.text }}</a>{% else %}{{ ocs_shell.announcement.text }}{% endif %}</span>
    <button type="button" class="ocs-announce-close" aria-label="{{ ocs_shell.t.ocs_close }}">&times;</button>
  </div>
</div>
{% endif %}
<nav id="top" class="ocs-util" aria-label="{{ text_account }}">
  <div class="container">
    {% if ocs_shell and (ocs_shell.phones or ocs_shell.messengers or ocs_shell.address or ocs_shell.hours) %}
    <div class="dropdown ocs-contact">
      <button type="button" class="ocs-util-btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true">{{ ocs_shell.t.ocs_contacts }} <svg class="ocs-i ocs-i-sm" aria-hidden="true"><use href="#i-chevron-down"/></svg></button>
      <ul class="dropdown-menu ocs-contact-menu">
        {% for phone in ocs_shell.phones %}<li><a href="{{ phone.href }}" class="ocs-crow"><span class="ocs-cicon"><svg class="ocs-i" aria-hidden="true"><use href="#i-phone"/></svg></span><span class="ocs-crow-text">{{ phone.text }}{% if phone.label %}<small>{{ phone.label }}</small>{% endif %}</span></a></li>{% endfor %}
        {% for link in ocs_shell.messengers|merge(ocs_shell.contact_social) %}<li><a href="{{ link.href }}" class="ocs-crow" target="_blank" rel="noopener noreferrer"><span class="ocs-bchip ocs-bchip-{{ link.key }}"><svg class="ocs-i" aria-hidden="true"><use href="#{{ link.icon }}"/></svg></span><span class="ocs-crow-text">{{ link.title }}</span></a></li>{% endfor %}
        {% if ocs_shell.hours %}<li class="ocs-crow ocs-crow-info"><span class="ocs-cicon"><svg class="ocs-i" aria-hidden="true"><use href="#i-clock"/></svg></span><span class="ocs-crow-text">{{ ocs_shell.hours }}</span></li>{% endif %}
        {% if ocs_shell.address %}<li class="ocs-crow ocs-crow-info"><span class="ocs-cicon"><svg class="ocs-i" aria-hidden="true"><use href="#i-pin"/></svg></span><address class="ocs-crow-text">{{ ocs_shell.address }}</address></li>{% endif %}
      </ul>
    </div>
    {% endif %}
    {% if ocs_shell %}
    <ul class="list-inline ocs-strip">
      {% for link in ocs_shell.links %}
      <li>{% if link.href %}<a href="{{ link.href }}">{{ link.text }}</a>{% else %}<span>{{ link.text }}</span>{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}
    <div class="ocs-util-end">
      {% if ocs_top %}
      <div class="ocs-top">
        {% if ocs_top.blog %}<a class="ocs-top-link{% if ocs_top.blog.active %} is-active{% endif %}" href="{{ ocs_top.blog.href }}"{% if ocs_top.blog.active %} aria-current="page"{% endif %}>{{ ocs_top.blog.title }}</a>{% endif %}
        {% if ocs_top.sale %}<a class="ocs-top-link ocs-top-sale{% if ocs_top.sale.active %} is-active{% endif %}" href="{{ ocs_top.sale.href }}"{% if ocs_top.sale.active %} aria-current="page"{% endif %}><svg class="ocs-i" aria-hidden="true"><use href="#i-percent"/></svg>{{ ocs_top.sale.title }}</a>{% endif %}
        {% if ocs_top.pages %}
        <div class="dropdown ocs-top-drop">
          <button type="button" class="ocs-util-btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true">{{ ocs_top.title }} <svg class="ocs-i ocs-i-sm" aria-hidden="true"><use href="#i-chevron-down"/></svg></button>
          <ul class="dropdown-menu dropdown-menu-right">
            {% for page in ocs_top.pages %}<li><a href="{{ page.href }}"{% if page.active %} aria-current="page" class="is-active"{% endif %}>{{ page.title }}</a></li>{% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
      {% endif %}
      {% if not (ocs_top and ocs_top.blog) %}{{ blog_menu }}{% endif %}{{ language }}{{ currency }}</div>
  </div>
</nav>
<header class="ocs-head">
  <div class="container ocs-head-grid">
    <div id="logo" class="ocs-head-logo">
      {% if logo %}
        {% if home == og_url %}
          <img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-responsive" />
        {% else %}
          <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-responsive" /></a>
        {% endif %}
      {% else %}
        <h1><a href="{{ home }}">{{ name }}</a></h1>
      {% endif %}
    </div>
    <div class="ocs-head-cat">{{ menu }}</div>
    <div class="ocs-head-search">{{ search }}</div>
    <div class="ocs-head-actions" id="top-links">
      <div class="dropdown ocs-act">
        <a href="{{ account }}" class="ocs-act-btn dropdown-toggle" data-toggle="dropdown" title="{{ text_account }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-user"/></svg>{% if logged and first_name %}<span class="ocs-act-name">{{ first_name|e }}</span>{% endif %}</a>
        <ul class="dropdown-menu dropdown-menu-right">
          {% if logged %}
          <li><a href="{{ account }}">{{ text_account }}</a></li>
          <li><a href="{{ order }}">{{ text_order }}</a></li>
          <li><a href="{{ transaction }}">{{ text_transaction }}</a></li>
          <li><a href="{{ download }}">{{ text_download }}</a></li>
          <li><a href="{{ logout }}">{{ text_logout }}</a></li>
          {% else %}
          <li><a href="{{ register }}">{{ text_register }}</a></li>
          <li><a href="{{ login }}">{{ text_login }}</a></li>
          {% endif %}
        </ul>
      </div>
      {% if ocs_shell %}
      <a href="{{ ocs_shell.compare }}" class="ocs-act ocs-act-btn" id="ocs-compare-link" title="{{ ocs_shell.compare_text }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-compare"/></svg><span id="compare-total" class="ocs-sr">{{ ocs_shell.compare_text }}</span></a>
      {% endif %}
      <a href="{{ wishlist }}" class="ocs-act ocs-act-btn" id="wishlist-total" title="{{ text_wishlist }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-heart"/></svg><span class="ocs-sr">{{ text_wishlist }}</span></a>
      <div class="ocs-act ocs-head-cart" data-label="{{ text_shopping_cart }}">{{ cart }}</div>
    </div>
  </div>
</header>
<div class="ocs-page">
