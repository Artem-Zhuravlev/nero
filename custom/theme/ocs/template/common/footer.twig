{# @core-file catalog/view/theme/default/template/common/footer.twig @core-version 3.0.3.7 #}
</div>{# .ocs-page opened in common/header.twig #}
<footer class="ocs-foot">
  <div class="container">
    {% if ocs_shell and (ocs_shell.address or ocs_shell.phones or ocs_shell.hours or ocs_shell.messengers or ocs_shell.social) %}
    <div class="ocs-foot-contacts">
      <h2 class="ocs-fh">{{ ocs_shell.t.ocs_contacts }}</h2>
      {% if ocs_shell.phones %}
      <ul class="ocs-foot-phones list-unstyled">
        {% for phone in ocs_shell.phones %}<li><a href="{{ phone.href }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-phone"/></svg><span>{{ phone.text }}</span></a>{% if phone.label %}<small>{{ phone.label }}</small>{% endif %}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if ocs_shell.hours %}<p class="ocs-foot-row"><svg class="ocs-i" aria-hidden="true"><use href="#i-clock"/></svg><span>{{ ocs_shell.hours }}</span></p>{% endif %}
      {% if ocs_shell.address %}<address class="ocs-foot-row"><svg class="ocs-i" aria-hidden="true"><use href="#i-pin"/></svg><span>{{ ocs_shell.address }}</span></address>{% endif %}
      {% set contact_icons = ocs_shell.messengers|merge(ocs_shell.social) %}
      {% if contact_icons %}
      <ul class="ocs-soc-list list-unstyled">
        {% for link in contact_icons %}<li><a class="ocs-crow" href="{{ link.href }}" target="_blank" rel="noopener noreferrer"><span class="ocs-bchip ocs-bchip-{{ link.key }}"><svg class="ocs-i" aria-hidden="true"><use href="#{{ link.icon }}"/></svg></span><span class="ocs-crow-text">{{ link.title }}</span></a></li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endif %}
    {% set has_contacts = ocs_shell and (ocs_shell.address or ocs_shell.phones or ocs_shell.hours or ocs_shell.messengers or ocs_shell.social) %}
    <div class="ocs-foot-groups{% if not has_contacts %} ocs-foot-groups--wide{% endif %}">
      {% if ocs_shell and ocs_shell.groups %}
      {% for group in ocs_shell.groups %}
      <div class="ocs-fcol">
        <details class="ocs-fgroup" open>
          <summary><h2 class="ocs-fh">{{ group.title }}</h2><svg class="ocs-i" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
          <ul class="list-unstyled">
            {% for link in group.links %}
            <li>{% if link.href %}<a href="{{ link.href }}">{{ link.text }}</a>{% else %}{{ link.text }}{% endif %}</li>
            {% endfor %}
          </ul>
        </details>
      </div>
      {% endfor %}
      {% elseif ocs_foot %}
      {% for group in ocs_foot.groups %}
      <div class="ocs-fcol">
        <details class="ocs-fgroup" open>
          <summary><h2 class="ocs-fh">{{ group.title }}</h2><svg class="ocs-i" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
          <ul class="list-unstyled">
            {% for link in group.links %}
            <li><a href="{{ link.href }}">{{ link.text }}</a></li>
            {% endfor %}
          </ul>
        </details>
      </div>
      {% endfor %}
      {% endif %}
    </div>
    <div class="ocs-foot-bottom">
      <p>{{ powered }}{% if ocs_cookie %} · <button type="button" class="ocs-cookie-reopen" data-ocs-cookie-reopen>{{ ocs_cookie.reopen }}</button>{% endif %}</p>
      {% if ocs_foot and ocs_foot.payments %}
      <ul class="ocs-pay list-unstyled" aria-label="Visa, Mastercard">
        <li><svg viewBox="0 0 48 30" role="img" aria-label="Visa"><rect width="48" height="30" rx="4" fill="#fff" stroke="#d9d9de"/><text x="24" y="21" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="14" font-weight="800" font-style="italic" letter-spacing="-0.5" fill="#1a1f71">VISA</text></svg></li>
        <li><svg viewBox="0 0 48 30" role="img" aria-label="Mastercard"><rect width="48" height="30" rx="4" fill="#fff" stroke="#d9d9de"/><circle cx="19" cy="15" r="8" fill="#eb001b"/><circle cx="29" cy="15" r="8" fill="#f79e1b"/><path d="M24 8.8a8 8 0 0 1 0 12.4 8 8 0 0 1 0-12.4Z" fill="#ff5f00"/></svg></li>
      </ul>
      {% endif %}
    </div>
  </div>
</footer>
{% if ocs_shell and ocs_shell.mobile_bar %}
<nav class="ocs-tabbar" aria-label="{{ ocs_shell.t.ocs_tabbar }}">
  <button type="button" id="ocs-tab-catalog"><svg class="ocs-i" aria-hidden="true"><use href="#i-menu"/></svg><span>{{ ocs_shell.t.ocs_tab_catalog }}</span></button>
  <a href="{{ ocs_shell.compare }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-compare"/></svg><span>{{ ocs_shell.t.ocs_tab_compare }}</span></a>
  <a href="{{ wishlist }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-heart"/></svg><span>{{ ocs_shell.t.ocs_tab_lists }}</span></a>
  <a href="{{ account }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-user"/></svg><span>{{ ocs_shell.t.ocs_tab_profile }}</span></a>
  <a class="ocs-tab-cart" href="{{ ocs_shell.cart }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg><span>{{ ocs_shell.t.ocs_tab_cart }}</span></a>
</nav>
{% endif %}
{% if ocs_cookie %}
<div class="ocs-cookie ocs-cookie--{{ ocs_cookie.position }}" id="ocs-cookie" role="dialog" aria-label="{{ ocs_cookie.label }}"{% if ocs_cookie.title %} aria-labelledby="ocs-cookie-title"{% endif %} data-version="{{ ocs_cookie.version }}" data-days="{{ ocs_cookie.days }}" hidden>
  <div class="ocs-cookie-body">
    {% if ocs_cookie.title %}<p class="ocs-cookie-title" id="ocs-cookie-title">{{ ocs_cookie.title }}</p>{% endif %}
    <p class="ocs-cookie-text">{{ ocs_cookie.text }}{% if ocs_cookie.link_href %} <a href="{{ ocs_cookie.link_href }}">{{ ocs_cookie.link_label }}</a>{% endif %}</p>
  </div>
  <div class="ocs-cookie-actions">
    <button type="button" class="btn btn-primary" data-ocs-cookie="all">{{ ocs_cookie.accept }}</button>
    {% if ocs_cookie.necessary %}<button type="button" class="btn btn-primary" data-ocs-cookie="necessary">{{ ocs_cookie.necessary }}</button>{% endif %}
  </div>
</div>
{% endif %}
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
</body></html>
