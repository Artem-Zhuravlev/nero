{# @core-file catalog/view/theme/default/template/product/compare.twig @core-version 3.0.3.7 #}
{{ header }}
<div id="product-compare" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  {% if success %}
  <div class="alert alert-success alert-dismissible">{{ success }}
   
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if products and ocs_cmp %}
      {% set cols = products|length %}
      <nav class="ocs-cmp-tabs" aria-label="{{ ocs_cmp.t.groups }}">
        {% for tab in ocs_cmp.tabs %}<a href="{{ tab.href }}" class="ocs-cmp-tab{% if tab.active %} is-active{% endif %}"{% if tab.active %} aria-current="page"{% endif %}>{{ tab.name }} <span class="ocs-cmp-count">{{ tab.count }}</span></a>{% endfor %}
      </nav>
      <label class="ocs-cmp-switch" id="ocs-cmp-switch" hidden><input type="checkbox" id="ocs-cmp-diff" /> <span>{{ ocs_cmp.t.only_diff }}</span></label>
      {% if ocs_cmp.single %}
      <p class="ocs-cmp-hint">{{ ocs_cmp.t.more }} <a href="{{ ocs_cmp.category }}">{{ ocs_cmp.t.category }}</a></p>
      {% endif %}
      <div class="ocs-cmp-scroll" style="--cols: {{ cols }}">
        <table class="ocs-cmp-table" id="ocs-cmp-table">
          <thead>
            <tr>
              <th class="ocs-cmp-corner" scope="col"><span class="ocs-sr">{{ text_product }}</span></th>
              {% for product in products %}
              <th scope="col" class="ocs-cmp-head">
                <a href="{{ product.remove }}" class="ocs-cmp-remove" title="{{ button_remove }}" aria-label="{{ button_remove }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-x"/></svg></a>
                <div class="ocs-cmp-top">
                  {% if product.thumb %}<a href="{{ product.href }}" class="ocs-cmp-img"><img src="{{ product.thumb }}" alt="{{ product.name }}" /></a>{% endif %}
                  <div class="ocs-cmp-buy">
                    {% if product.price %}<span class="ocs-cmp-price">{% if product.special %}<strong>{{ product.special }}</strong> <s>{{ product.price }}</s>{% else %}<strong>{{ product.price }}</strong>{% endif %}</span>{% endif %}
                    {% if ocs_show_stock %}<span class="ocs-cmp-stock">{{ product.availability }}</span>{% endif %}
                  </div>
                </div>
                <a href="{{ product.href }}" class="ocs-cmp-name">{{ product.name }}</a>
                <div class="ocs-cmp-foot">
                  {% if review_status %}<span class="ocs-stars" role="img" aria-label="{{ product.rating }} / 5">{% for i in 1..5 %}<svg class="ocs-i ocs-star{% if product.rating >= i %} is-on{% endif %}" aria-hidden="true"><use href="#i-star"/></svg>{% endfor %}</span>{% endif %}
                  <button type="button" class="ocs-cart-btn" title="{{ button_cart }}" aria-label="{{ button_cart }}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg></button>
                </div>
              </th>
              {% endfor %}
            </tr>
          </thead>
          {% for group in ocs_cmp.groups %}
          <tbody class="ocs-cmp-group">
            <tr class="ocs-cmp-gh"><th colspan="{{ cols + 1 }}" scope="colgroup"><button type="button" class="ocs-cmp-toggle" aria-expanded="true">{{ group.name }}<svg class="ocs-i" aria-hidden="true"><use href="#i-chevron-down"/></svg></button></th></tr>
            {% for row in group.rows %}{% if row.key != 'model' or ocs_show_sku %}
            <tr class="ocs-cmp-row" data-same="{{ row.same ? 1 : 0 }}">
              <th scope="row">{{ row.name }}</th>
              {% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}
            </tr>
            {% endif %}{% endfor %}
          </tbody>
          {% endfor %}
        </table>
      </div>
      <p class="ocs-cmp-same" id="ocs-cmp-same" hidden>{{ ocs_cmp.t.same }}</p>
      {% elseif products %}
      <table class="table table-bordered">
        <thead>
          <tr>
            <td colspan="{{ products|length + 1 }}"><strong>{{ text_product }}</strong></td>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{{ text_name }}</td>
            {% for product in products %}
            <td><a href="{{ product.href }}"><strong>{{ product.name }}</strong></a></td>
            {% endfor %} </tr>
          <tr>
            <td>{{ text_image }}</td>
            {% for product in products %}
            <td class="text-center">{% if product.thumb %} <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-thumbnail" /> {% endif %}</td>
            {% endfor %} </tr>
          <tr>
            <td>{{ text_price }}</td>
            {% for product in products %}
            <td>{% if product.price %}
              {% if not product.special %}
              {{ product.price }}
              {% else %} <strike>{{ product.price }}</strike> {{ product.special }}
              {% endif %}
              {% endif %}</td>
            {% endfor %} </tr>
          {% if ocs_show_sku %}<tr>
            <td>{{ text_model }}</td>
            {% for product in products %}
            <td>{{ product.model }}</td>
            {% endfor %} </tr>{% endif %}
          <tr>
            <td>{{ text_manufacturer }}</td>
            {% for product in products %}
            <td>{{ product.manufacturer }}</td>
            {% endfor %} </tr>
          {% if ocs_show_stock %}<tr>
            <td>{{ text_availability }}</td>
            {% for product in products %}
            <td>{{ product.availability }}</td>
            {% endfor %} </tr>{% endif %}
        {% if review_status %}
        <tr>
          <td>{{ text_rating }}</td>
          {% for product in products %}
          <td class="rating"> <span class="ocs-stars" role="img" aria-label="{{ product.rating }} / 5">{% for i in 1..5 %}<svg class="ocs-i ocs-star{% if product.rating >= i %} is-on{% endif %}" aria-hidden="true"><use href="#i-star"/></svg>{% endfor %}</span> <br />
            {{ product.reviews }}</td>
          {% endfor %} </tr>
        {% endif %}
        <tr>
          <td>{{ text_summary }}</td>
          {% for product in products %}
          <td class="description">{{ product.description }}</td>
          {% endfor %} </tr>
        <tr>
          <td>{{ text_weight }}</td>
          {% for product in products %}
          <td>{{ product.weight }}</td>
          {% endfor %} </tr>
        <tr>
          <td>{{ text_dimension }}</td>
          {% for product in products %}
          <td>{{ product.length }} x {{ product.width }} x {{ product.height }}</td>
          {% endfor %} </tr>
          </tbody>
        
        {% for attribute_group in attribute_groups %}
        <thead>
          <tr>
            <td colspan="{{ products|length + 1 }}"><strong>{{ attribute_group.name }}</strong></td>
          </tr>
        </thead>
        {% for key, attribute in attribute_group.attribute %}
        <tbody>
          <tr>
            <td>{{ attribute.name }}</td>
            {% for product in products %}
            {% if product.attribute[key] %}
            <td> {{ product.attribute[key] }}</td>
            {% else %}
            <td></td>
            {% endif %}
            {% endfor %}
          </tr>
        </tbody>
        {% endfor %}
        {% endfor %}
        <tr>
          <td></td>
          {% for product in products %}
          <td><input type="button" value="{{ button_cart }}" class="btn btn-primary btn-block" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" />
            <a href="{{ product.remove }}" class="btn btn-danger btn-block">{{ button_remove }}</a></td>
          {% endfor %} </tr>
      </table>
      {% else %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-default">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }} 