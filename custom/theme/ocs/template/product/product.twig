{# @core-file catalog/view/theme/default/template/product/product.twig @core-version 3.0.3.7 #}
{{ header }}
<div class="ocs-sticky-buy" id="ocs-sticky-buy" hidden aria-hidden="true"><div class="container ocs-sticky-inner">{% if thumb %}<img src="{{ thumb }}" alt="" width="40" height="40" />{% endif %}<strong>{{ heading_title }}</strong>{% if price %}<span class="ocs-sticky-price">{{ special ? special : price }}</span>{% endif %}<button type="button" class="btn btn-primary" data-ocs-buy>{{ button_cart }}</button></div></div>
<div id="product-product" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  {% if ocs_px %}
  <nav class="ocs-sections" id="ocs-sections" aria-label="{{ heading_title }}">
    {% for s in ocs_px.sections %}<a href="{{ s.href }}"{% if s.tab %} data-ocs-tab="1"{% endif %}>{{ s.text }}</a>{% endfor %}
  </nav>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="row ocs-pdp"> {% if column_left or column_right %}
        {% set class = 'col-sm-6' %}
        {% else %}
        {% set class = 'col-sm-8' %}
        {% endif %}
        <div class="{{ class }}"> {% if thumb or images %}
          <div class="ocs-gallery"><div class="ocs-slot ocs-slot-tr">{% for s in ocs_stickers.tl %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}{% for s in ocs_stickers.tr %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div><div class="ocs-slot ocs-slot-bl">{% for s in ocs_stickers.bl %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div>

          {% if ocs_px.gallery %}
          <div class="ocs-gal" data-ocs-gallery="1" data-ocs-lb="{{ ocs_px.lb }}">
            <div class="ocs-gal-main swiper-container">
              <ul class="thumbnails swiper-wrapper">
                {% for g in ocs_px.gallery %}
                <li class="swiper-slide"><a class="thumbnail" href="{{ g.popup }}" title="{{ heading_title }}"><img src="{{ g.main }}" title="{{ heading_title }}" alt="{{ heading_title }}" width="{{ ocs_px.main_w }}" height="{{ ocs_px.main_h }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %} /></a></li>
                {% endfor %}
                {% if ocs_px.video %}<li class="swiper-slide ocs-gal-video"><button type="button" class="ocs-vid" data-ocs-video="{{ ocs_px.video.id }}" data-embed="{{ ocs_px.video.embed }}" aria-label="{{ ocs_px.video.label }}"><img src="{{ ocs_px.video.poster }}" alt="" loading="lazy" /><span class="ocs-vid-play"><svg class="ocs-i" aria-hidden="true"><use href="#i-play"/></svg></span></button></li>{% endif %}
              </ul>
            </div>
            {% if ocs_px.gallery|length + (ocs_px.video ? 1 : 0) > 1 %}
            <div class="ocs-gal-thumbs swiper-container">
              <div class="swiper-wrapper">
                {% for g in ocs_px.gallery %}<div class="swiper-slide"><img src="{{ g.thumb }}" alt="" loading="lazy" /></div>{% endfor %}
                {% if ocs_px.video %}<div class="swiper-slide ocs-gal-vthumb"><img src="{{ ocs_px.video.poster }}" alt="{{ ocs_px.video.label }}" loading="lazy" /><span class="ocs-vid-play"><svg class="ocs-i" aria-hidden="true"><use href="#i-play"/></svg></span></div>{% endif %}
              </div>
            </div>
            {% endif %}
          </div>
          {% else %}
          <ul class="thumbnails">
            {% if thumb %}
            <li><a class="thumbnail" href="{{ popup }}" title="{{ heading_title }}"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}"{% if ocs_px.thumb_w %} width="{{ ocs_px.thumb_w }}" height="{{ ocs_px.thumb_h }}" fetchpriority="high"{% endif %} /></a></li>
            {% endif %}
            {% if images %}
            {% for image in images %}
            <li class="image-additional"><a class="thumbnail" href="{{ image.popup }}" title="{{ heading_title }}"> <img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></a></li>
            {% endfor %}
            {% endif %}
          </ul>
          {% endif %}
          </div>
          {% endif %}

        </div>
        {% if column_left or column_right %}
        {% set class = 'col-sm-6' %}
        {% else %}
        {% set class = 'col-sm-4' %}
        {% endif %}
        <div class="{{ class }}">
          <div class="ocs-pdp-head">
            <h1>{{ heading_title }}</h1>
            <div class="ocs-pdp-tools">
              <button type="button" data-toggle="tooltip" class="btn btn-default" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-heart"/></svg></button>
              <button type="button" data-toggle="tooltip" class="btn btn-default" title="{{ button_compare }}" aria-label="{{ button_compare }}" onclick="compare.add('{{ product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-compare"/></svg></button>
            </div>
          </div>
          {% if ocs_show_sku and model %}
          <div class="ocs-code-pill"><span class="ocs-code-label">{{ ocs_px.text_product_code ? ocs_px.text_product_code : text_model }}</span> <span class="ocs-code-val">{{ model }}</span><button type="button" class="ocs-copy" data-ocs-copy="{{ model }}" data-done="{{ ocs_px.text_copied }}" title="{{ ocs_px.text_copy }}" aria-label="{{ ocs_px.text_copy }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-copy"/></svg></button><span class="ocs-sr" role="status" aria-live="polite"></span></div>
          {% endif %}
          {% if ocs_px.key_attrs %}
          <div class="ocs-key-attrs" role="group" aria-label="{{ ocs_px.text_key_attrs }}">
            {% for a in ocs_px.key_attrs %}<span class="ocs-attr-chip"><span class="text-muted">{{ a.name }}:</span> {{ a.text }}</span>{% endfor %}
          </div>
          {% endif %}
          {% if manufacturer or ocs_show_sku or ocs_show_stock or reward %}
          <dl class="ocs-facts">
            {% if manufacturer %}<div><dt>{{ text_manufacturer }}</dt><dd><a href="{{ manufacturers }}">{{ manufacturer }}</a></dd></div>{% endif %}
            {% if ocs_show_sku %}<div><dt>{{ text_model }}</dt><dd>{{ model }}</dd></div>{% endif %}
            {% if reward %}<div><dt>{{ text_reward }}</dt><dd>{{ reward }}</dd></div>{% endif %}
            {% if ocs_show_stock %}<div><dt>{{ text_stock }}</dt><dd>{% if ocs_stock %}<span class="ocs-stock ocs-stock-{{ ocs_stock.state }}">{{ ocs_stock.label }}</span>{% else %}{{ stock }}{% endif %}</dd></div>{% endif %}
          </dl>
          {% endif %}
          {% if price %}
          <div class="ocs-price-box">
            {% if special %}
            <p class="ocs-price-old"><s>{{ price }}</s></p>
            <p class="ocs-price ocs-price-special">{{ special }}{% if ocs_savings %} <span class="ocs-savings">{{ ocs_savings_label }} {{ ocs_savings }}</span>{% endif %}</p>
            {% else %}
            <p class="ocs-price">{{ price }}</p>
            {% endif %}
            {% if ocs_special_timer %}
            <p class="ocs-special-timer" role="timer" aria-live="off" data-ocs-timer="{{ ocs_special_timer.seconds }}" data-days="{{ ocs_special_timer.days }}"><span class="ocs-special-timer-label">{{ ocs_special_timer.label }}</span> <strong class="ocs-special-timer-time"></strong></p>
            {% endif %}
            {% if tax %}<p class="ocs-price-note">{{ text_tax }} {{ tax }}</p>{% endif %}
            {% if points %}<p class="ocs-price-note">{{ text_points }} {{ points }}</p>{% endif %}
            {% if discounts %}
            <div class="ocs-discounts">
              {% for discount in discounts %}<p class="ocs-price-note">{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</p>{% endfor %}
            </div>
            {% endif %}
          </div>
          {% endif %}
          <div id="product"{% if ocs_preorder %} class="ocs-preorder"{% endif %}> {% include 'ocs/template/ocs/options.twig' %}
            {% if recurrings %}
            <hr>
            <h2 class="ocs-block-title">{{ text_payment_recurring }}</h2>
            <div class="form-group required">
              <select name="recurring_id" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for recurring in recurrings %}
                <option value="{{ recurring.recurring_id }}">{{ recurring.name }}</option>
                {% endfor %}
              </select>
              <div class="help-block" id="recurring-description"></div>
            </div>
            {% endif %}
            <div class="form-group">
              <label class="control-label" for="input-quantity">{{ entry_qty }}</label>
              <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" class="form-control" />
              <input type="hidden" name="product_id" value="{{ product_id }}" />
              <br />
              <button type="button" id="button-cart" data-loading-text="{{ text_loading }}" class="btn btn-primary btn-lg btn-block">{{ button_cart }}</button>
              <div class="ocs-buy-slot" id="ocs-buy-slot">
                {% if ocs_preorder %}<button type="button" class="btn btn-primary btn-lg btn-block ocs-req-btn ocs-preorder-btn" data-form="{{ ocs_preorder.form }}" data-product-id="{{ product_id }}" data-collect="1">{{ ocs_preorder.text }}</button>{% if ocs_preorder.note %}<p class="ocs-req-note">{{ ocs_preorder.note }}</p>{% endif %}{% endif %}
                {% if ocs_quick and not ocs_preorder %}<button type="button" class="btn btn-default btn-lg btn-block ocs-req-btn ocs-quick-btn" data-form="{{ ocs_quick.form }}" data-product-id="{{ product_id }}" data-collect="1">{{ ocs_quick.text }}</button>{% endif %}
                {% if ocs_preorder_opt %}<button type="button" class="btn btn-primary btn-lg btn-block ocs-req-btn ocs-preorder-btn ocs-out-only" hidden data-form="{{ ocs_preorder_opt.form }}" data-product-id="{{ product_id }}" data-collect="1">{{ ocs_preorder_opt.text }}</button>{% endif %}
                {% if ocs_subscribe_opt %}<button type="button" class="btn btn-default btn-lg btn-block ocs-req-btn ocs-subscribe-btn ocs-out-only" hidden data-form="{{ ocs_subscribe_opt.form }}" data-product-id="{{ product_id }}" data-collect="1">{{ ocs_subscribe_opt.text }}</button>{% endif %}
                {% if ocs_subscribe %}<button type="button" class="btn btn-default btn-lg btn-block ocs-req-btn ocs-subscribe-btn" data-form="{{ ocs_subscribe.form }}" data-product-id="{{ product_id }}" data-collect="1">{{ ocs_subscribe.text }}</button>{% endif %}
              </div>
            </div>
            {% if minimum > 1 %}
            <div class="alert alert-info">{{ text_minimum }}</div>
            {% endif %}</div>
          {% if ocs_info_blocks %}
          <div class="ocs-info-blocks">
            {% for b in ocs_info_blocks %}
            <div class="ocs-info-card">
              <svg class="ocs-i" aria-hidden="true"><use href="#{{ b.icon }}"/></svg>
              <div>
                {% if b.title %}<p class="ocs-info-title">{% if b.href %}<a href="{{ b.href }}">{{ b.title }}</a>{% else %}{{ b.title }}{% endif %}</p>{% endif %}
                {% if b.text %}<p class="ocs-info-text">{{ b.text }}</p>{% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {% if review_status %}
          <div class="rating">
            <p>{% include 'ocs/template/ocs/rating.twig' with {'value': rating} only %} <a href="#tab-review">{{ reviews }}</a> / <a href="#form-review">{{ text_write }}</a></p>
            <hr>
                      </div>
          {% endif %} </div>
      </div>
      <div class="ocs-pdp-body">
      <div class="ocs-pdp-sections">
        <section class="ocs-section" id="tab-description">
          <div class="ocs-sec-title">{{ tab_description }}</div>
          <div class="ocs-section-body">{{ description }}</div>
        </section>
        {% if attribute_groups %}
        <section class="ocs-section" id="tab-specification">
          <div class="ocs-sec-title">{{ tab_attribute }}</div>
              <table class="table table-bordered">
                {% for attribute_group in attribute_groups %}
                <thead>
                  <tr>
                    <td colspan="2"><strong>{{ attribute_group.name }}</strong></td>
                  </tr>
                </thead>
                <tbody>
                {% for attribute in attribute_group.attribute %}
                <tr>
                  <td>{{ attribute.name }}</td>
                  <td>{{ attribute.text }}</td>
                </tr>
                {% endfor %}
                  </tbody>
                {% endfor %}
              </table>
        </section>
        {% endif %}
        {% if review_status %}
        <section class="ocs-section" id="tab-review">
          <div class="ocs-sec-head"><div class="ocs-sec-title">{{ tab_review }}</div><button type="button" class="btn btn-primary ocs-js-only" data-ocs-popup="ocs-review-box" aria-haspopup="dialog">{{ text_write }}</button></div>
            {% if ocs_px.stars.total %}
            <div class="ocs-stars-sum">
              <div class="ocs-stars-avg"><strong>{{ ocs_px.stars.avg }}</strong><span>{{ ocs_px.stars.title }}: {{ ocs_px.stars.total }}</span></div>
              <ul class="ocs-stars-bars">
                {% for r in ocs_px.stars.rows %}<li><span>{{ r.rating }} <svg class="ocs-i ocs-i-sm ocs-i-fill" aria-hidden="true"><use href="#i-star"/></svg></span><i style="--pct: {{ r.pct }}%"></i><span>{{ r.count }}</span></li>{% endfor %}
              </ul>
            </div>
            {% endif %}
          <div id="review"></div>
          <div class="ocs-popup-box" id="ocs-review-box" data-close="{{ ocs_px.text_lb_close }}">
          <form class="ocs-form" id="form-review">
            <h2 class="ocs-form-title" id="ocs-review-title">{{ text_write }}</h2>
            {% if review_guest %}
            <fieldset class="ocs-field required ocs-rating-field">
              <legend>{{ entry_rating }}</legend>
              <div class="ocs-rate">
                {% for i in 5..1 %}<input type="radio" name="rating" value="{{ i }}" id="input-rating-{{ i }}" /><label for="input-rating-{{ i }}" title="{{ i }}"><span class="ocs-sr">{{ i }}</span><svg class="ocs-i" aria-hidden="true"><use href="#i-star"/></svg></label>{% endfor %}
              </div>
              <p class="ocs-help"><span>{{ entry_bad }}</span> <span>{{ entry_good }}</span></p>
            </fieldset>
            <div class="ocs-field required">
              <label for="input-name">{{ entry_name }}</label>
              <input placeholder="{{ entry_name }}" type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" autocomplete="name" />
            </div>
            <div class="ocs-field">
              <label for="input-pros"><span class="ocs-pm ocs-pm-plus" aria-hidden="true">+</span> {{ ocs_px.entry_pros }}</label>
              <input type="text" placeholder="{{ ocs_px.entry_pros }}" name="pros" id="input-pros" maxlength="255" class="form-control" />
            </div>
            <div class="ocs-field">
              <label for="input-cons"><span class="ocs-pm ocs-pm-minus" aria-hidden="true">&minus;</span> {{ ocs_px.entry_cons }}</label>
              <input type="text" placeholder="{{ ocs_px.entry_cons }}" name="cons" id="input-cons" maxlength="255" class="form-control" />
            </div>
            <div class="ocs-field required">
              <label for="input-review">{{ entry_review }}</label>
              <textarea placeholder="{{ entry_review }}" name="text" rows="5" id="input-review" class="form-control"></textarea>
              <p class="ocs-help">{{ text_note }}</p>
            </div>
            {{ captcha }}
            <div id="review-msg" role="status" aria-live="polite"></div>
            <div class="ocs-form-actions">
              <button type="button" class="btn btn-default ocs-js-only" data-ocs-popup-close>{{ ocs_px.button_cancel }}</button>
              <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn btn-primary">{{ button_continue }}</button>
            </div>
            {% else %}
            <p>{{ text_login }}</p>
            {% endif %}
          </form>
          </div>
        </section>
        {% endif %}
        {% if ocs_px.qa %}
        <section class="ocs-section" id="tab-questions">
          <div class="ocs-sec-head"><div class="ocs-sec-title">{{ ocs_px.qa.label }}</div><button type="button" class="btn btn-primary ocs-js-only" data-ocs-popup="ocs-question-box" aria-haspopup="dialog">{{ ocs_px.qa.ask.text_ask_title }}</button></div>
            {% for q in ocs_px.qa.list %}
            <div class="ocs-q">
              <p><strong>{{ q.name }}</strong> <span class="text-muted">{{ q.date }}</span></p>
              <p>{{ q.text }}</p>
              {% if q.answer %}<p class="ocs-q-answer"><strong>{{ ocs_px.qa.ask.text_answer }}</strong> {{ q.answer }}</p>{% endif %}
            </div>
            {% else %}
            <p class="text-muted">{{ ocs_px.qa.ask.text_no_questions }}</p>
            {% endfor %}
          <div class="ocs-popup-box" id="ocs-question-box" data-close="{{ ocs_px.text_lb_close }}">
          <form class="ocs-form ocs-news-form ocs-q-form" action="{{ ocs_px.qa.action }}" method="post" data-failed="{{ ocs_px.qa.ask.error_generic }}" novalidate>
            <h2 class="ocs-form-title" id="ocs-question-title">{{ ocs_px.qa.ask.text_ask_title }}</h2>
            <input type="hidden" name="token" value="{{ ocs_px.qa.token }}" />
            <input type="hidden" name="product_id" value="{{ product_id }}" />
            <div class="ocs-news-hp" aria-hidden="true"><label>Website <input type="text" name="website" value="" tabindex="-1" autocomplete="off" /></label></div>
            <div class="ocs-form-grid">
              <div class="ocs-field">
                <label for="input-q-name">{{ ocs_px.qa.ask.entry_name }}</label>
                <input placeholder="{{ ocs_px.qa.ask.entry_name }}" type="text" name="name" value="{{ ocs_px.qa.name }}" id="input-q-name" class="form-control" autocomplete="name" />
              </div>
              <div class="ocs-field">
                <label for="input-q-email">{{ ocs_px.qa.ask.entry_email }}</label>
                <input placeholder="{{ ocs_px.qa.ask.entry_email }}" type="email" name="email" value="{{ ocs_px.qa.email }}" id="input-q-email" class="form-control" autocomplete="email" />
              </div>
            </div>
            <div class="ocs-field">
              <label for="input-q-text">{{ ocs_px.qa.ask.entry_question }}</label>
              <textarea placeholder="{{ ocs_px.qa.ask.entry_question }}" name="text" rows="4" id="input-q-text" class="form-control"></textarea>
            </div>
            <div class="ocs-form-actions">
              <button type="submit" class="btn btn-primary">{{ ocs_px.qa.ask.button_ask }}</button>
              <div class="ocs-news-msg" role="status" aria-live="polite"></div>
            </div>
          </form>
          </div>
        </section>
        {% endif %}
      </div>
      <aside class="ocs-side-card" aria-label="{{ heading_title }}">
        <div class="ocs-side-img">
          {% if thumb %}<img src="{{ thumb }}" alt="" loading="lazy" />{% endif %}
          <div class="ocs-slot ocs-slot-tl">{% for s in ocs_stickers.tl %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div>
          <div class="ocs-slot ocs-slot-tr">{% for s in ocs_stickers.tr %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div>
        </div>
        {% if manufacturer %}<a class="ocs-side-brand" href="{{ manufacturers }}">{{ manufacturer }}</a>{% endif %}
        <p class="ocs-side-title">{{ heading_title }}</p>
        {% if ocs_show_sku and model %}
        <div class="ocs-code-pill ocs-code-pill-sm"><span class="ocs-code-label">{{ ocs_px.text_product_code ? ocs_px.text_product_code : text_model }}</span> <span class="ocs-code-val">{{ model }}</span><button type="button" class="ocs-copy" data-ocs-copy="{{ model }}" data-done="{{ ocs_px.text_copied }}" title="{{ ocs_px.text_copy }}" aria-label="{{ ocs_px.text_copy }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-copy"/></svg></button><span class="ocs-sr" role="status" aria-live="polite"></span></div>
        {% endif %}
        {% if price %}<p class="ocs-side-price">{% if special %}<s>{{ price }}</s> <strong>{{ special }}</strong>{% else %}<strong>{{ price }}</strong>{% endif %}</p>{% endif %}
        {% if ocs_show_stock and ocs_stock %}<p class="ocs-side-stock"><span class="ocs-stock ocs-stock-{{ ocs_stock.state }}"><i class="ocs-dot" aria-hidden="true"></i>{{ ocs_stock.label }}</span></p>{% endif %}
        <div class="ocs-side-actions">
          <button type="button" class="btn btn-primary" data-ocs-buy>{% if ocs_preorder %}{{ ocs_preorder.text }}{% elseif ocs_subscribe %}{{ ocs_subscribe.text }}{% else %}{{ button_cart }}{% endif %}</button>
          <button type="button" class="btn btn-default" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-heart"/></svg></button>
          <button type="button" class="btn btn-default" title="{{ button_compare }}" aria-label="{{ button_compare }}" onclick="compare.add('{{ product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-compare"/></svg></button>
        </div>
      </aside>
      </div>
      {% for block in [{'id': 'ocs-accessories', 'title': ocs_px.text_accessories, 'items': ocs_px.accessories}, {'id': 'ocs-similar', 'title': ocs_px.text_similar, 'items': ocs_px.similar}] %}
      {% if block.items %}
      <section class="ocs-pcarousel" id="{{ block.id }}" aria-label="{{ block.title }}">
        <div class="ocs-pcarousel-head"><div class="ocs-sec-title">{{ block.title }}</div></div>
        <div class="ocs-carousel" role="region" aria-label="{{ block.title }}">
          <div class="ocs-carousel-track">
            {% for product in block.items %}
            <div class="ocs-carousel-item">{% include 'ocs/template/ocs/card.twig' %}</div>
            {% endfor %}
          </div>
          <button type="button" class="ocs-carousel-prev" aria-label="{{ ocs_px.text_prev }}">&lsaquo;</button>
          <button type="button" class="ocs-carousel-next" aria-label="{{ ocs_px.text_next }}">&rsaquo;</button>
        </div>
      </section>
      {% endif %}
      {% endfor %}
      {% if products %}
      <div class="ocs-sec-title">{{ text_related }}</div>
      <div class="row"> {% set i = 0 %}
        {% for product in products %}
        {% if column_left and column_right %}
        {% set class = 'col-xs-8 col-sm-6' %}
        {% elseif column_left or column_right %}
        {% set class = 'col-xs-6 col-md-4' %}
        {% else %}
        {% set class = 'col-xs-6 col-sm-3' %}
        {% endif %}
        <div class="{{ class }}">
          <div class="product-thumb transition">
            <div class="image">{% if product.has_video %}<span class="ocs-vid-badge" role="img" aria-label="{{ text_video }}" title="{{ text_video }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-play"/></svg></span>{% endif %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a></div>
            <div class="caption">
              <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
              <p>{{ product.description }}</p>
              {% if product.rating %}
              <div class="rating"> {% include 'ocs/template/ocs/rating.twig' with {'value': product.rating} only %} </div>
              {% endif %}
              {% if product.price %}
              <p class="price"> {% if not product.special %}
                {{ product.price }}
                {% else %} <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span> {% endif %}
                {% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> {% endif %} </p>
              {% endif %} </div>
            <div class="button-group">
              <button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><span class="hidden-xs hidden-sm hidden-md">{{ button_cart }}</span> <svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg></button>
              <button type="button" data-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-heart"/></svg></button>
              <button type="button" data-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-compare"/></svg></button>
            </div>
          </div>
        </div>
        {% if column_left and column_right and (i + 1) % 2 == 0 %}
        <div class="clearfix visible-md visible-sm"></div>
        {% elseif column_left or column_right and (i + 1) % 3 == 0 %}
        <div class="clearfix visible-md"></div>
        {% elseif (i + 1) % 4 == 0 %}
        <div class="clearfix visible-md"></div>
        {% endif %}
        {% set i = i + 1 %}
        {% endfor %} </div>
        {% endif %}
        {% if tags %}
        <p>{{ text_tags }}
        {% for i in 0..tags|length - 1 %}
        {% if i < (tags|length - 1) %} <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a>,
        {% else %} <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a> {% endif %}
        {% endfor %} </p>
        {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$('select[name=\'recurring_id\'], input[name="quantity"]').change(function(){
	$.ajax({
		url: 'index.php?route=product/product/getRecurringDescription',
		type: 'post',
		data: $('input[name=\'product_id\'], input[name=\'quantity\'], select[name=\'recurring_id\']'),
		dataType: 'json',
		beforeSend: function() {
			$('#recurring-description').html('');
		},
		success: function(json) {
			$('.alert-dismissible, .text-danger').remove();

			if (json['success']) {
				$('#recurring-description').html(json['success']);
			}
		}
	});
});
//--></script> 
<script type="text/javascript"><!--
$('#button-cart').on('click', function() {
	$.ajax({
		url: 'index.php?route=checkout/cart/add',
		type: 'post',
		data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
		dataType: 'json',
		beforeSend: function() {
			$('#button-cart').button('loading');
		},
		complete: function() {
			$('#button-cart').button('reset');
		},
		success: function(json) {
			$('.alert-dismissible, .text-danger').remove();
			$('.form-group').removeClass('has-error');

			if (json['error']) {
				if (json['error']['option']) {
					for (i in json['error']['option']) {
						var element = $('#input-option' + i.replace('_', '-'));

						if (element.parent().hasClass('input-group')) {
							element.parent().after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
						} else {
							element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
						}
					}
				}

				if (json['error']['recurring']) {
					$('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
				}

				// Highlight any found errors
				$('.text-danger').parent().addClass('has-error');
			}

			if (json['success']) {
				$('.breadcrumb').after('<div class="alert alert-success alert-dismissible">' + json['success'] + '</div>');

				$('#cart > button').html('<span id="cart-total"><svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg> ' + json['total'] + '</span>');

				$('#cart > ul').load('index.php?route=common/cart/info ul li');
			}
		},
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
	});
});
//--></script> 
<script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});

$('.datetime').datetimepicker({
	language: '{{ datepicker }}',
	pickDate: true,
	pickTime: true
});

$('.time').datetimepicker({
	language: '{{ datepicker }}',
	pickDate: false
});

$('button[id^=\'button-upload\']').on('click', function() {
	var node = this;

	$('#form-upload').remove();

	$('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

	$('#form-upload input[name=\'file\']').trigger('click');

	if (typeof timer != 'undefined') {
    	clearInterval(timer);
	}

	timer = setInterval(function() {
		if ($('#form-upload input[name=\'file\']').val() != '') {
			clearInterval(timer);

			$.ajax({
				url: 'index.php?route=tool/upload',
				type: 'post',
				dataType: 'json',
				data: new FormData($('#form-upload')[0]),
				cache: false,
				contentType: false,
				processData: false,
				beforeSend: function() {
					$(node).button('loading');
				},
				complete: function() {
					$(node).button('reset');
				},
				success: function(json) {
					$('.text-danger').remove();

					if (json['error']) {
						$(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
					}

					if (json['success']) {
						alert(json['success']);

						$(node).parent().find('input').val(json['code']);
					}
				},
				error: function(xhr, ajaxOptions, thrownError) {
					alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
				}
			});
		}
	}, 500);
});
//--></script> 
<script type="text/javascript"><!--
$('#review').delegate('.pagination a', 'click', function(e) {
    e.preventDefault();

    $('#review').fadeOut('slow');

    $('#review').load(this.href);

    $('#review').fadeIn('slow');
});

$('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');

$('#button-review').on('click', function() {
	$.ajax({
		url: 'index.php?route=product/product/write&product_id={{ product_id }}',
		type: 'post',
		dataType: 'json',
		data: $("#form-review").serialize(),
		beforeSend: function() {
			$('#button-review').button('loading');
		},
		complete: function() {
			$('#button-review').button('reset');
		},
		success: function(json) {
			$('#review-msg').empty();

			if (json['error']) {
				$('#review-msg').html('<div class="alert alert-danger">' + json['error'] + '</div>');
			}

			if (json['success']) {
				$('#review-msg').html('<div class="alert alert-success">' + json['success'] + '</div>');

				$('input[name=\'name\']').val('');
				$('textarea[name=\'text\']').val('');
				$('input[name=\'rating\']:checked').prop('checked', false);
				$('#form-review input[name=\'pros\'], #form-review input[name=\'cons\']').val('');

				// the popup (theme.js) closes after the message has been read
				if (window.OCS && OCS.popup) {
					setTimeout(OCS.popup.close, 2200);
				}
			}
		}
	});
});

$(document).ready(function() {
	// the gallery opens the theme lightbox (theme.js, SPEC-048); only the markup without the swipeable gallery keeps the core popup
	if (!$('[data-ocs-gallery]').length) {
		$('.thumbnails').magnificPopup({
			type:'image',
			delegate: 'a',
			gallery: {
				enabled: true
			}
		});
	}
});
