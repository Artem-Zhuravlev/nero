{# @core-file catalog/view/theme/default/template/product/manufacturer_list.twig @core-version 3.0.3.7 #}
{# Brands page with a client-side brand search (SPEC-074), restyled as chips and tiles (SPEC-075). #}
{{ header }}
<div id="product-manufacturer" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if categories %}
      <div class="ocs-brand-search"><input type="search" id="ocs-brand-search" class="form-control" placeholder="{{ ocs_brand_search }}" aria-label="{{ ocs_brand_search }}" autocomplete="off" /></div>
      <nav id="ocs-brand-index" class="ocs-brand-index" aria-label="{{ text_index }}"><strong>{{ text_index }}</strong>
        {% for category in categories %}<a data-brand-letter="{{ category.name }}" href="index.php?route=product/manufacturer#{{ category.name }}">{{ category.name }}</a>
        {% endfor %}</nav>
      <div id="ocs-brand-groups">
      {% for category in categories %}
      <section class="ocs-brand-group" data-brand-letter="{{ category.name }}">
        <h2 id="{{ category.name }}">{{ category.name }}</h2>
        {% if category.manufacturer %}
        <div class="ocs-brand-grid">
          {% for manufacturer in category.manufacturer %}
          <a class="ocs-brand-item" href="{{ manufacturer.href }}">{{ manufacturer.name }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </section>
      {% endfor %}
      </div>
      <p id="ocs-brand-none" hidden>{{ ocs_brand_none }}</p>
      {% else %}
      <p>{{ text_empty }}</p>
      <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}