{# @core-file catalog/view/theme/default/template/blog/review.twig @core-version 3.0.3.7 #}
{# @generated by scripts/gen-theme-templates.mjs #}
{% if reviews %}
{% for review in reviews %}
<table class="table table-striped table-bordered">
  <tr>
    <td style="width: 50%;"><strong>{{ review.author }}</strong></td>
    <td class="text-right">{{ review.date_added }}</td>
  </tr>
  <tr>
    <td colspan="2"><p>{{ review.text }}</p>
      <span class="ocs-stars" role="img" aria-label="{{ review.rating }} / 5">{% for i in 1..5 %}<svg class="ocs-i ocs-star{% if review.rating >= i %} is-on{% endif %}" aria-hidden="true"><use href="#i-star"/></svg>{% endfor %}</span></td>
  </tr>
</table>
{% endfor %}
<div class="text-right">{{ pagination }}</div>
{% else %}
<p>{{ text_no_reviews }}</p>
{% endif %} 