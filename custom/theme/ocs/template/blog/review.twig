{# @core-file catalog/view/theme/default/template/blog/review.twig @core-version 3.0.3.7 #}
{# SPEC-084 REQ-BLG-032: comments as cards with stars and reactions. Hand-written override (no generated marker). #}
{% if reviews %}
<ul class="ocs-comment-list">
  {% for review in reviews %}
  <li class="ocs-comment">
    <div class="ocs-comment-head">
      <strong class="ocs-comment-author">{{ review.author }}</strong>
      <time class="ocs-comment-date">{{ review.date_added }}</time>
      <span class="ocs-stars" role="img" aria-label="{{ review.rating }} / 5">{% for i in 1..5 %}<svg class="ocs-i ocs-star{% if review.rating >= i %} is-on{% endif %}" aria-hidden="true"><use href="#i-star"/></svg>{% endfor %}</span>
    </div>
    <p class="ocs-comment-text">{{ review.text }}</p>
    {% if review.id and ocs_vote_url %}
    <div class="ocs-comment-foot">{% include 'ocs/template/ocs/blog_react.twig' with {rtype: 'comment', rid: review.id, likes: review.likes, dislikes: review.dislikes, mine: review.mine, vote_url: ocs_vote_url, text_like: text_like, text_dislike: text_dislike} %}</div>
    {% endif %}
  </li>
  {% endfor %}
</ul>
<div class="text-right">{{ pagination }}</div>
{% else %}
<p class="text-muted">{{ text_no_reviews }}</p>
{% endif %}
