{# @core-file catalog/view/theme/default/template/blog/article.twig @core-version 3.0.3.7 #}
{# SPEC-084: author, publication date, reactions, popup comment form and shared cards. Hand-written override (no generated marker). #}
{{ header }}
<div id="blog-article" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <article class="ocs-article">
        <header class="ocs-article-head">
          <h1>{{ heading_title }}</h1>
          <div class="ocs-article-meta">
            {% if ocs_blog and ocs_blog.date %}<span class="ocs-meta-item"><svg class="ocs-i" aria-hidden="true"><use href="#i-calendar"/></svg><time datetime="{{ ocs_blog.date_iso }}">{{ ocs_blog.date }}</time></span>{% endif %}
            {% if ocs_blog and ocs_blog.author %}<span class="ocs-meta-item ocs-bcard-author">{% if ocs_blog.author.thumb %}<img src="{{ ocs_blog.author.thumb }}" alt="" width="24" height="24" />{% else %}<i aria-hidden="true">{{ ocs_blog.author.initial }}</i>{% endif %}<span>{{ ocs_blog.author.name }}</span></span>{% endif %}
            {% if review_status %}<a class="ocs-meta-item" href="#tab-review"><span class="ocs-stars" role="img" aria-label="{{ rating }} / 5">{% for i in 1..5 %}<svg class="ocs-i ocs-star{% if rating >= i %} is-on{% endif %}" aria-hidden="true"><use href="#i-star"/></svg>{% endfor %}</span> {{ reviews }}</a>{% endif %}
          </div>
        </header>

        {% if thumb %}
        <figure class="ocs-article-cover thumbnails"><a class="thumbnail" href="{{ popup }}" title="{{ heading_title }}"><img src="{{ thumb }}" alt="{{ heading_title }}" fetchpriority="high" /></a></figure>
        {% endif %}
        {% if images %}
        <ul class="ocs-article-gallery thumbnails">
          {% for image in images %}<li><a class="thumbnail" href="{{ image.popup }}" title="{{ heading_title }}"><img src="{{ image.thumb }}" alt="{{ heading_title }}" loading="lazy" /></a></li>{% endfor %}
        </ul>
        {% endif %}

        <div class="ocs-article-body" id="tab-description">{{ description }}</div>

        {% if download_status and downloads %}
        <ul class="ocs-article-files">
          {% for download in downloads %}<li><a href="{{ download.href }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-download"/></svg> {{ download.name }} <span class="text-muted">{{ download.size }}</span></a></li>{% endfor %}
        </ul>
        {% endif %}

        {% if ocs_blog %}
        <div class="ocs-article-vote">
          <span>{{ ocs_blog.t.text_helpful }}</span>
          {% include 'ocs/template/ocs/blog_react.twig' with {rtype: 'article', rid: ocs_blog.article_id, likes: ocs_blog.likes, dislikes: ocs_blog.dislikes, mine: ocs_blog.mine, vote_url: ocs_blog.vote_url, text_like: ocs_blog.t.text_like, text_dislike: ocs_blog.t.text_dislike} %}
        </div>

        {% if ocs_blog.author %}
        <aside class="ocs-author" aria-label="{{ ocs_blog.t.text_author_label }}">
          <div class="ocs-author-pic">{% if ocs_blog.author.thumb %}<img src="{{ ocs_blog.author.thumb }}" alt="{{ ocs_blog.author.name }}" width="96" height="96" loading="lazy" />{% else %}<i aria-hidden="true">{{ ocs_blog.author.initial }}</i>{% endif %}</div>
          <div class="ocs-author-info">
            <p class="ocs-author-label">{{ ocs_blog.t.text_author_label }}</p>
            <p class="ocs-author-name">{{ ocs_blog.author.name }}</p>
            {% if ocs_blog.author.position %}<p class="ocs-author-pos">{{ ocs_blog.author.position }}</p>{% endif %}
            {% if ocs_blog.author.description %}<p class="ocs-author-text">{{ ocs_blog.author.description }}</p>{% endif %}
            {% if ocs_blog.author.social %}
            <ul class="ocs-author-social">
              {% for s in ocs_blog.author.social %}<li><a href="{{ s.url }}" target="_blank" rel="noopener nofollow me" aria-label="{{ s.label }}" title="{{ s.label }}"><svg class="ocs-i" aria-hidden="true"><use href="#{{ s.icon }}"/></svg></a></li>{% endfor %}
            </ul>
            {% endif %}
          </div>
        </aside>
        {% endif %}
        {% endif %}
      </article>

      {% if products %}
      <section class="ocs-section">
        <h2 class="ocs-sec-title">{{ text_related_product }}</h2>
        <div class="row">
          {% for product in products %}
          {% include 'ocs/template/ocs/card.twig' %}
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if articles %}
      <section class="ocs-section">
        <h2 class="ocs-sec-title">{{ text_related }}</h2>
        <div class="ocs-bgrid">
          {% for article in articles %}
          {% include 'ocs/template/ocs/blog_card.twig' %}
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if review_status %}
      <section class="ocs-section ocs-comments" id="tab-review">
        <div class="ocs-sec-head"><h2 class="ocs-sec-title">{{ ocs_blog ? ocs_blog.t.text_comments : text_write }}</h2><button type="button" class="btn btn-primary ocs-js-only" data-ocs-popup="ocs-review-box" aria-haspopup="dialog">{{ ocs_blog ? ocs_blog.t.button_write_comment : text_write }}</button></div>
        <div id="review"></div>
        <div class="ocs-popup-box" id="ocs-review-box" data-close="{{ ocs_blog ? ocs_blog.t.text_close : '' }}">
          <form class="ocs-form" id="form-review">
            <h2 class="ocs-form-title" id="ocs-review-title">{{ ocs_blog ? ocs_blog.t.button_write_comment : text_write }}</h2>
            {% if review_guest %}
            <fieldset class="ocs-field required ocs-rating-field">
              <legend>{{ entry_rating }}</legend>
              <div class="ocs-rate">
                {% for i in 5..1 %}<input type="radio" name="rating" value="{{ i }}" id="input-rating-{{ i }}" /><label for="input-rating-{{ i }}" title="{{ i }}"><span class="ocs-sr">{{ i }}</span><svg class="ocs-i" aria-hidden="true"><use href="#i-star"/></svg></label>{% endfor %}
              </div>
              <p class="ocs-help"><span>{{ entry_bad }}</span> <span>{{ entry_good }}</span></p>
            </fieldset>
            <div class="ocs-field required">
              <label for="input-name">{{ entry_name }}</label>
              <input placeholder="{{ entry_name }}" type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" autocomplete="name" />
            </div>
            <div class="ocs-field required">
              <label for="input-review">{{ entry_review }}</label>
              <textarea placeholder="{{ entry_review }}" name="text" rows="5" id="input-review" class="form-control"></textarea>
              <p class="ocs-help">{{ text_note }}</p>
            </div>
            {{ captcha }}
            <div id="review-msg" role="status" aria-live="polite"></div>
            <div class="ocs-form-actions">
              <button type="button" class="btn btn-default ocs-js-only" data-ocs-popup-close>{{ ocs_blog ? ocs_blog.t.button_cancel : button_cancel }}</button>
              <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn btn-primary">{{ button_continue }}</button>
            </div>
            {% else %}
            <p>{{ text_login }}</p>
            {% endif %}
          </form>
        </div>
      </section>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
if ($.fn.magnificPopup) {
	$('.thumbnails').magnificPopup({ type: 'image', delegate: 'a', gallery: { enabled: true } });
}

$('#review').load('index.php?route=blog/article/review&article_id={{ article_id }}');

$('#review').on('click', '.pagination a', function(e) {
	e.preventDefault();

	$('#review').load(this.href);
});

$('#button-review').on('click', function() {
	$.ajax({
		url: 'index.php?route=blog/article/write&article_id={{ article_id }}',
		type: 'post',
		dataType: 'json',
		data: $('#form-review').serialize(),
		beforeSend: function() {
			$('#button-review').button('loading');
		},
		complete: function() {
			$('#button-review').button('reset');
		},
		success: function(json) {
			$('#review-msg').empty();

			if (json['error']) {
				$('#review-msg').html('<div class="alert alert-danger">' + json['error'] + '</div>');
			}

			if (json['success']) {
				$('#review-msg').html('<div class="alert alert-success">' + json['success'] + '</div>');

				$('#form-review input[name=\'name\']').val('');
				$('#form-review textarea[name=\'text\']').val('');
				$('#form-review input[name=\'rating\']:checked').prop('checked', false);

				if (window.OCS && OCS.popup) {
					setTimeout(OCS.popup.close, 2200);
				}
			}
		}
	});
});
//--></script>
{{ footer }}
