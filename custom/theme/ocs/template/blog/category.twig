{# @core-file catalog/view/theme/default/template/blog/category.twig @core-version 3.0.3.7 #}
{# SPEC-084: shared article cards and grid. Hand-written override (no generated marker). #}
{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }} showcase-list">{{ content_top }}
      <h1>{{ heading_title }}</h1>
	   {% if description %}
      <div class="row">
        {% if description %}
        <div class="col-sm-12">{{ description }}</div>
		{% endif %}
      </div>
      <hr>
	  {% endif %}
      {% if articles %}
      <div class="ocs-blog-sort">
        <label class="control-label" for="input-sort">{{ text_sort }}</label>
        <select id="input-sort" class="form-control" onchange="location = this.value;">
          {% for sorts in sorts %}
          {% if sorts.value == '%s-%s'|format(sort, order) %}
          <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
          {% else %}
          <option value="{{ sorts.href }}">{{ sorts.text }}</option>
          {% endif %}
          {% endfor %}
        </select>
      </div>
      <div class="ocs-bgrid">
        {% for article in articles %}
        {% include 'ocs/template/ocs/blog_card.twig' %}
        {% endfor %}
      </div>
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}