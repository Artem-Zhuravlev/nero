{# Product card partial for listing overrides (SPEC-034 REQ-LST-010, 012). Core has no product/thumb.twig; the markup is derived from the inlined card of product/category.twig. #}
{# Context: product, text_tax, button_cart, button_wishlist, button_compare. Extra keys added by ocs_listing events: model, reviews, discount_pct. #}
<div class="product-layout product-list col-xs-12" data-product-id="{{ product.product_id }}">
  <div class="product-thumb">
    <div class="image">
      <div class="ocs-slot ocs-slot-tl" data-product-id="{{ product.product_id }}"></div><div class="ocs-slot ocs-slot-tr" data-product-id="{{ product.product_id }}"></div><div class="ocs-slot ocs-slot-bl" data-product-id="{{ product.product_id }}"></div>
      {% if product.discount_pct %}<span class="ocs-badge ocs-badge-discount">-{{ product.discount_pct }}%</span>{% endif %}
      <a href="{{ product.href }}"><img src="{{ product.thumb }}" loading="lazy" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a>
    </div>
    <div>
      <div class="caption">
        {% if product.model %}<div class="ocs-code">{{ product.model }}</div>{% endif %}
        <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
        <p class="ocs-desc">{{ product.description }}</p>
        {% if product.ocs_stock %}<div class="ocs-stock ocs-stock-{{ product.ocs_stock.state }}">{{ product.ocs_stock.label }}</div>{% endif %}
        {% if product.price %}
        <p class="price"> {% if not product.special %}
          {{ product.price }}
          {% else %} <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span> {% endif %}
          {% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> {% endif %} </p>
        {% endif %}
        {% if product.rating %}
        <div class="rating"> {% for i in 1..5 %}
          {% if product.rating < i %} <span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span> {% else %} <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>{% endif %}
          {% endfor %}{% if product.reviews %} <span class="ocs-reviews">({{ product.reviews }})</span>{% endif %} </div>
        {% endif %} </div>
      {% if ocs_quick %}<div class="ocs-quick-card"><button type="button" class="btn btn-default btn-sm btn-block ocs-req-btn ocs-quick-btn" data-form="{{ ocs_quick.form }}" data-product-id="{{ product.product_id }}">{{ ocs_quick.text }}</button></div>{% endif %}
      <div class="button-group">
        <button type="button" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa fa-shopping-cart"></i> <span class="hidden-xs hidden-sm hidden-md">{{ button_cart }}</span></button>
        <button type="button" data-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart"></i></button>
        <button type="button" data-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
      </div>
    </div>
  </div>
</div>
