{# Product card partial for listing overrides (SPEC-034 REQ-LST-010, 012; SPEC-039 REQ-VIS-004). Core has no product/thumb.twig; the markup is derived from the inlined card of product/category.twig. #}
{# Context: product, text_tax, button_cart, button_wishlist, button_compare. Extra keys added by ocs_listing events: model, reviews, discount_pct. #}
<div class="product-layout product-list col-xs-12" data-product-id="{{ product.product_id }}">
  {% set ocs_out = (product.ocs_stock and product.ocs_stock.state == 'out') or (product.quantity is defined and product.quantity <= 0) %}
  <div class="product-thumb{% if ocs_out %} is-out{% endif %}">
    <div class="image">
      <div class="ocs-slot ocs-slot-tl" data-product-id="{{ product.product_id }}">{% for s in product.stickers.tl %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div><div class="ocs-slot ocs-slot-tr" data-product-id="{{ product.product_id }}">{% for s in product.stickers.tr %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div><div class="ocs-slot ocs-slot-bl" data-product-id="{{ product.product_id }}">{% for s in product.stickers.bl %}<span class="ocs-badge" style="--badge-bg: {{ s.bg }}; --badge-fg: {{ s.fg }}">{{ s.text }}</span>{% endfor %}</div>

      {% if product.discount_pct and not product.stickers %}<span class="ocs-badge ocs-badge-discount">-{{ product.discount_pct }}%</span>{% endif %}
      {% if product.has_video %}<span class="ocs-vid-badge" role="img" aria-label="{{ text_video }}" title="{{ text_video }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-play"/></svg></span>{% endif %}
      {% if product.model %}<span class="ocs-code">{{ product.model }}</span>{% endif %}
      <div class="ocs-card-tools">
        {% if product.remove %}
        <a href="{{ product.remove }}" data-ocs-wish-remove="{{ product.product_id }}" class="ocs-tool ocs-tool-remove" title="{{ button_remove }}" aria-label="{{ button_remove }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-x"/></svg></a>
        {% else %}
        <button type="button" class="ocs-tool" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-heart"/></svg></button>
        {% endif %}
        <button type="button" class="ocs-tool" title="{{ button_compare }}" aria-label="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-compare"/></svg></button>
      </div>
      <a href="{{ product.href }}" class="ocs-card-img"><img src="{{ product.thumb }}" loading="lazy" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a>
    </div>
    <div>
      <div class="caption">
        <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
        {% if product.rating %}
        <div class="rating"> {% include 'ocs/template/ocs/rating.twig' with {'value': product.rating} only %}{% if product.reviews %} <span class="ocs-reviews">({{ product.reviews }})</span>{% endif %} </div>
        {% endif %}
        {% if product.ocs_stock %}<div class="ocs-stock ocs-stock-{{ product.ocs_stock.state }}"><i class="ocs-dot" aria-hidden="true"></i>{{ product.ocs_stock.label }}</div>{% endif %}
        <div class="ocs-buy-row">
          {% if product.price %}
          <p class="price"> {% if not product.special %}
            <span class="price-cur">{{ product.price }}</span>
            {% else %} <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span> {% endif %}
            {% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> {% endif %} </p>
          {% endif %}
          {% if ocs_out %}
          <button type="button" class="ocs-cart-btn ocs-notify-btn ocs-req-btn" data-product-id="{{ product.product_id }}" aria-label="Notify" title="Notify"><svg class="ocs-i" aria-hidden="true"><use href="#i-bell"/></svg></button>
          {% elseif product.ocs_options %}
          <a class="ocs-cart-btn" href="{{ product.href }}" title="{{ button_cart }}" aria-label="{{ button_cart }}"><svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg></a>
          {% else %}
          <button type="button" class="ocs-cart-btn" title="{{ button_cart }}" aria-label="{{ button_cart }}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg></button>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
