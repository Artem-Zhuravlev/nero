{# @core-file catalog/view/theme/default/template/account/wishlist.twig @core-version 3.0.3.7 #}
{{ header }}
<div id="account-wishlist" class="container">
  <ul class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    {% for breadcrumb in breadcrumbs %}
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">{% if loop.last %}<span itemprop="name" aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a itemprop="item" href="{{ breadcrumb.href }}"><span itemprop="name">{{ breadcrumb.text }}</span></a>{% endif %}<meta itemprop="position" content="{{ loop.index }}" /></li>
    {% endfor %}
  </ul>
  {% if success %}
  <div class="alert alert-success alert-dismissible"><svg class="ocs-i" aria-hidden="true"><use href="#i-check"/></svg> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h2>{{ heading_title }}</h2>
      {% if products %}
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <td class="text-center">{{ column_image }}</td>
              <td class="text-left">{{ column_name }}</td>
              {% if ocs_show_sku %}<td class="text-left">{{ column_model }}</td>{% endif %}
              {% if ocs_show_stock %}<td class="text-right">{{ column_stock }}</td>{% endif %}
              <td class="text-right">{{ column_price }}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
          
          {% for product in products %}
          <tr>
            <td class="text-center">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a>{% endif %}</td>
            <td class="text-left"><a href="{{ product.href }}">{{ product.name }}</a></td>
            {% if ocs_show_sku %}<td class="text-left">{{ product.model }}</td>{% endif %}
            {% if ocs_show_stock %}<td class="text-right">{{ product.stock }}</td>{% endif %}
            <td class="text-right">{% if product.price %}
              <div class="price"> {% if not product.special %}
                {{ product.price }}
                {% else %} <b>{{ product.special }}</b> <s>{{ product.price }}</s> {% endif %} </div>
              {% endif %}</td>
            <td class="text-right"><button type="button" onclick="cart.add('{{ product.product_id }}');" data-toggle="tooltip" title="{{ button_cart }}" class="btn btn-primary"><svg class="ocs-i" aria-hidden="true"><use href="#i-cart"/></svg></button>
              <a href="{{ product.remove }}" data-ocs-wish-remove="{{ product.product_id }}" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><svg class="ocs-i" aria-hidden="true"><use href="#i-x"/></svg></a></td>
          </tr>
          {% endfor %}
            </tbody>
          
        </table>
      </div>
      {% else %}
      <div class="ocs-acc-empty"><svg class="ocs-i" aria-hidden="true"><use href="#i-package"/></svg><p>{{ text_empty }}</p></div>
      {% endif %}
      <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}