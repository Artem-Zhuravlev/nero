{# @core-file catalog/view/theme/default/template/account/account.twig @core-version 3.0.3.7 #}
{{ header }}
<div id="account-account" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  {% if success %}
  <div class="alert alert-success alert-dismissible">{{ success }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="ocs-acc-grid">
      <section class="ocs-acc-card">
        <h2 class="ocs-acc-title"><svg class="ocs-i" aria-hidden="true"><use href="#i-user"/></svg>{{ text_my_account }}</h2>
        <div class="ocs-acc-tiles">
          <a class="ocs-acc-tile" href="{{ edit }}"><span>{{ text_edit }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ password }}"><span>{{ text_password }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ address }}"><span>{{ text_address }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ wishlist }}"><span>{{ text_wishlist }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
        </div>
      </section>
      {% if credit_cards %}
      <section class="ocs-acc-card">
        <h2 class="ocs-acc-title"><svg class="ocs-i" aria-hidden="true"><use href="#i-card"/></svg>{{ text_credit_card }}</h2>
        <div class="ocs-acc-tiles">
          {% for credit_card in credit_cards %}
          <a class="ocs-acc-tile" href="{{ credit_card.href }}"><span>{{ credit_card.name }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          {% endfor %}
        </div>
      </section>
      {% endif %}
      <section class="ocs-acc-card">
        <h2 class="ocs-acc-title"><svg class="ocs-i" aria-hidden="true"><use href="#i-package"/></svg>{{ text_my_orders }}</h2>
        <div class="ocs-acc-tiles">
          <a class="ocs-acc-tile" href="{{ order }}"><span>{{ text_order }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ download }}"><span>{{ text_download }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          {% if reward %}
          <a class="ocs-acc-tile" href="{{ reward }}"><span>{{ text_reward }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          {% endif %}
          <a class="ocs-acc-tile" href="{{ return }}"><span>{{ text_return }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ transaction }}"><span>{{ text_transaction }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ recurring }}"><span>{{ text_recurring }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
        </div>
      </section>
      <section class="ocs-acc-card">
        <h2 class="ocs-acc-title"><svg class="ocs-i" aria-hidden="true"><use href="#i-percent"/></svg>{{ text_my_affiliate }}</h2>
        <div class="ocs-acc-tiles">
          {% if not tracking %}
          <a class="ocs-acc-tile" href="{{ affiliate }}"><span>{{ text_affiliate_add }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          {% else %}
          <a class="ocs-acc-tile" href="{{ affiliate }}"><span>{{ text_affiliate_edit }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          <a class="ocs-acc-tile" href="{{ tracking }}"><span>{{ text_tracking }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
          {% endif %}
        </div>
      </section>
      <section class="ocs-acc-card">
        <h2 class="ocs-acc-title"><svg class="ocs-i" aria-hidden="true"><use href="#i-mail"/></svg>{{ text_my_newsletter }}</h2>
        <div class="ocs-acc-tiles">
          <a class="ocs-acc-tile" href="{{ newsletter }}"><span>{{ text_newsletter }}</span><svg class="ocs-i ocs-acc-go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
        </div>
      </section>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}