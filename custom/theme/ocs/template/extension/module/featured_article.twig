{# @core-file catalog/view/theme/default/template/extension/module/featured_article.twig @core-version 3.0.3.7 #}
{# SPEC-099: shared article cards and grid, like blog_latest. Hand-written override (no generated marker). #}
{% if articles %}
<section class="ocs-section ocs-blog-module">
  <div class="ocs-sec-title">{{ heading_title }}</div>
  <div class="ocs-bgrid">
    {% for article in articles %}
    {% include 'ocs/template/ocs/blog_card.twig' %}
    {% endfor %}
  </div>
</section>
{% endif %}
