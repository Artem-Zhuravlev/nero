{# @core-file catalog/view/theme/default/template/extension/module/special.twig @core-version 3.0.3.7 #}
{# SPEC-056: product modules use the shared ocs card partial (REQ-MPC-001). #}
{% if products %}
<section class="ocs-modcards">
  <h2 class="ocs-sec-title">{{ heading_title }}</h2>
  <div class="ocs-cards">
    {% for product in products %}
    {% include 'ocs/template/ocs/card.twig' %}
    {% endfor %}
  </div>
</section>
{% endif %}
