{# @core-file catalog/view/theme/default/template/information/contact.twig @core-version 3.0.3.7 #}
{{ header }}
<div id="information-contact" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}</li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% set c_address = ocs_shell.address ?: address %}
      {% set c_hours = ocs_shell.hours ?: open %}
      {% set c_links = ocs_shell ? ocs_shell.messengers|merge(ocs_shell.social) : [] %}
      <div class="ocs-contacts">
        <div class="ocs-cc-grid">
          {% if c_address or geocode %}
          <section class="ocs-cc-card">
            <span class="ocs-cc-ico"><svg class="ocs-i" aria-hidden="true"><use href="#i-pin"/></svg></span>
            <h2 class="ocs-cc-h">{{ ocs_shell.t.ocs_address ?: text_location }}</h2>
            <address class="ocs-cc-text"><strong>{{ store }}</strong><br />{{ c_address }}</address>
            {% if geocode %}<a href="https://maps.google.com/maps?q={{ geocode|url_encode }}&hl={{ geocode_hl }}&t=m&z=15" target="_blank" rel="noopener" class="btn btn-default"><svg class="ocs-i" aria-hidden="true"><use href="#i-pin"/></svg> {{ button_map }}</a>{% endif %}
          </section>
          {% endif %}
          {% if ocs_shell.phones or telephone %}
          <section class="ocs-cc-card">
            <span class="ocs-cc-ico"><svg class="ocs-i" aria-hidden="true"><use href="#i-phone"/></svg></span>
            <h2 class="ocs-cc-h">{{ text_telephone }}</h2>
            <ul class="ocs-cc-list list-unstyled">
              {% if ocs_shell.phones %}
              {% for phone in ocs_shell.phones %}<li><a href="{{ phone.href }}">{{ phone.text }}</a>{% if phone.label %}<small>{{ phone.label }}</small>{% endif %}</li>{% endfor %}
              {% else %}
              <li>{{ telephone }}</li>
              {% endif %}
              {% if fax %}<li><small>{{ text_fax }}</small>{{ fax }}</li>{% endif %}
            </ul>
          </section>
          {% endif %}
          {% if c_hours or comment %}
          <section class="ocs-cc-card">
            <span class="ocs-cc-ico"><svg class="ocs-i" aria-hidden="true"><use href="#i-clock"/></svg></span>
            <h2 class="ocs-cc-h">{{ ocs_shell.hours ? ocs_shell.t.ocs_hours : text_open }}</h2>
            {% if c_hours %}<p class="ocs-cc-text ocs-cc-pre">{{ c_hours }}</p>{% endif %}
            {% if comment %}<p class="ocs-cc-text ocs-cc-pre">{{ comment }}</p>{% endif %}
          </section>
          {% endif %}
          {% if c_links %}
          <section class="ocs-cc-card">
            <span class="ocs-cc-ico"><svg class="ocs-i" aria-hidden="true"><use href="#i-globe"/></svg></span>
            <h2 class="ocs-cc-h">{{ ocs_shell.t.ocs_social }}</h2>
            <ul class="ocs-soc-list list-unstyled">
              {% for link in c_links %}<li><a class="ocs-crow" href="{{ link.href }}" target="_blank" rel="noopener noreferrer"><span class="ocs-bchip ocs-bchip-{{ link.key }}"><svg class="ocs-i" aria-hidden="true"><use href="#{{ link.icon }}"/></svg></span><span class="ocs-crow-text">{{ link.title }}</span></a></li>{% endfor %}
            </ul>
          </section>
          {% endif %}
        </div>
      </div>
      {% if locations %}
      <h3>{{ text_store }}</h3>
      <div class="panel-group" id="accordion">
        {% for location in locations %}
        <div class="panel panel-default">
          <div class="panel-heading">
            <h4 class="panel-title"><a href="#collapse-location{{ location.location_id }}" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion">{{ location.name }} <svg class="ocs-i" aria-hidden="true"><use href="#i-chevron-down"/></svg></a></h4>
          </div>
          <div class="panel-collapse collapse" id="collapse-location{{ location.location_id }}">
            <div class="panel-body">
              <div class="row">
                {% if location.image %}
                <div class="col-sm-3"><img src="{{ location.image }}" alt="{{ location.name }}" title="{{ location.name }}" class="img-thumbnail" /></div>
                {% endif %}
                <div class="col-sm-3"><strong>{{ location.name }}</strong><br />
                  <address>
                  {{ location.address }}
                  </address>
                  {% if location.geocode %}
                  <a href="https://maps.google.com/maps?q={{ location.geocode|url_encode }}&hl={{ geocode_hl }}&t=m&z=15" target="_blank" class="btn btn-info"><svg class="ocs-i" aria-hidden="true"><use href="#i-pin"/></svg> {{ button_map }}</a>
                  {% endif %}
                </div>
                <div class="col-sm-3"> <strong>{{ text_telephone }}</strong><br>
                  {{ location.telephone }}<br />
                  <br />
                  {% if location.fax %}
                  <strong>{{ text_fax }}</strong><br>
                  {{ location.fax }}
                  {% endif %}
                </div>
                <div class="col-sm-3">
                  {% if location.open %}
                  <strong>{{ text_open }}</strong><br />
                  {{ location.open }}<br />
                  <br />
                  {% endif %}
                  {% if location.comment %}
                  <strong>{{ text_comment }}</strong><br />
                  {{ location.comment }}
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal ocs-contact-form">
        <fieldset>
          <legend>{{ text_contact }}</legend>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input placeholder="{{ entry_name }}" type="text" name="name" value="{{ name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-email">{{ entry_email }}</label>
            <div class="col-sm-10">
              <input placeholder="{{ entry_email }}" type="text" name="email" value="{{ email }}" id="input-email" class="form-control" />
              {% if error_email %}
              <div class="text-danger">{{ error_email }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-enquiry">{{ entry_enquiry }}</label>
            <div class="col-sm-10">
              <textarea placeholder="{{ entry_enquiry }}" name="enquiry" rows="10" id="input-enquiry" class="form-control">{{ enquiry }}</textarea>
              {% if error_enquiry %}
              <div class="text-danger">{{ error_enquiry }}</div>
              {% endif %}
            </div>
          </div>
          {{ captcha }}
        </fieldset>
        <div class="buttons">
          <div class="pull-right">
            <input class="btn btn-primary" type="submit" value="{{ button_submit }}" />
          </div>
        </div>
      </form>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
